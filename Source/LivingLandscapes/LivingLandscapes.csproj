<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\LocalBuild.props" Condition="Exists('..\..\LocalBuild.props')" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>LivingLandscapes</RootNamespace>
    <AssemblyName>LivingLandscapes</AssemblyName>

    <!-- Build straight into the mod's 1.7/Assemblies folder (the repo root is the mod). -->
    <OutputPath>..\..\1.7\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>portable</DebugType>

    <!-- Where RimWorld is installed: an environment variable, /p:RimWorldDir=..., or a git-ignored LocalBuild.props at the
         repository root (see CONTRIBUTING.md). Falls back to Steam's default library. -->
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldDir>
  </PropertyGroup>

  <!-- Game assemblies: referenced from the install, never copied or committed. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldDir)\Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Harmony 3 is provided at runtime by the Harmony mod, so compile against it only. -->
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.2" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- A clear message instead of dozens of missing-type errors when the game is not where RimWorldDir points. -->
  <Target Name="CheckRimWorldDir" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(RimWorldDir)\Assembly-CSharp.dll')">
    <Error Text="RimWorld not found at '$(RimWorldDir)'. Set RimWorldDir to your install folder (see CONTRIBUTING.md)." />
  </Target>

</Project>
