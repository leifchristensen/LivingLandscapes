<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Game-free unit tests for the pure math in the mod (raster operations on float grids). The source files are linked in,
    not referenced, so this project needs neither the game DLLs nor Harmony and runs anywhere `dotnet test` does.
    UnityEngine.Mathf is replaced by a small shim (UnityShim.cs). Only files with no Verse/RimWorld types belong here.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\LivingLandscapes\Geology\RankMath.cs" Link="Linked\RankMath.cs" />
    <Compile Include="..\LivingLandscapes\Geology\Throughflow.cs" Link="Linked\Throughflow.cs" />
    <Compile Include="..\LivingLandscapes\Geology\GridMath.cs" Link="Linked\GridMath.cs" />
    <Compile Include="..\LivingLandscapes\Geology\GroundCover.cs" Link="Linked\GroundCover.cs" />
    <Compile Include="..\LivingLandscapes\Geology\WaterDefinition.cs" Link="Linked\WaterDefinition.cs" />
    <Compile Include="..\LivingLandscapes\Geology\WaterBalanceMath.cs" Link="Linked\WaterBalanceMath.cs" />
    <Compile Include="..\LivingLandscapes\Geology\GroundRunoff.cs" Link="Linked\GroundRunoff.cs" />
    <Compile Include="..\LivingLandscapes\Geology\FloorSeepageRules.cs" Link="Linked\FloorSeepageRules.cs" />
    <Compile Include="..\LivingLandscapes\Geology\RegionalSlopeMath.cs" Link="Linked\RegionalSlopeMath.cs" />
    <Compile Include="..\LivingLandscapes\Geology\RiverEntryRules.cs" Link="Linked\RiverEntryRules.cs" />
    <Compile Include="..\LivingLandscapes\Geology\CoastMath.cs" Link="Linked\CoastMath.cs" />
    <Compile Include="..\LivingLandscapes\Geology\FedBasinRules.cs" Link="Linked\FedBasinRules.cs" />
    <Compile Include="..\LivingLandscapes\Geology\Standing.cs" Link="Linked\Standing.cs" />
    <Compile Include="..\LivingLandscapes\Geology\Hydraulics.cs" Link="Linked\Hydraulics.cs" />
    <Compile Include="..\LivingLandscapes\Geology\ConfluenceZones.cs" Link="Linked\ConfluenceZones.cs" />
    <Compile Include="..\LivingLandscapes\Geology\Confluences.cs" Link="Linked\Confluences.cs" />
    <Compile Include="..\LivingLandscapes\Geology\Sediment.cs" Link="Linked\Sediment.cs" />
    <Compile Include="..\LivingLandscapes\Geology\DepositLedger.cs" Link="Linked\DepositLedger.cs" />
    <Compile Include="..\LivingLandscapes\Geology\WatershedMath.cs" Link="Linked\WatershedMath.cs" />
    <Compile Include="..\LivingLandscapes\Geology\WorldAltitudeMath.cs" Link="Linked\WorldAltitudeMath.cs" />
    <Compile Include="..\LivingLandscapes\Flora\ShadeRadiusRules.cs" Link="Linked\ShadeRadiusRules.cs" />
    <Compile Include="..\LivingLandscapes\Overlay\TopologyBandMath.cs" Link="Linked\TopologyBandMath.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\1.7\Patches\PlantHabitats.xml" Link="PlantHabitats.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
