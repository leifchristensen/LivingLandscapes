<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <name>Living Landscapes</name>
  <author>Leif Christensen</author>
  <packageId>leifchristensen.livinglandscapes</packageId>
  <url>https://github.com/leifchristensen/LivingLandscapes</url>
  <supportedVersions>
    <li>1.7</li>
  </supportedVersions>
  <modDependencies>
    <li>
      <packageId>brrainz.harmony</packageId>
      <displayName>Harmony</displayName>
      <steamWorkshopUrl>steam://url/CommunityFilePageByID/2009463077</steamWorkshopUrl>
      <downloadUrl>https://github.com/pardeike/HarmonyRimWorld/releases/latest</downloadUrl>
    </li>
  </modDependencies>
  <loadAfter>
    <li>brrainz.harmony</li>
    <!-- Supported world generator: load after it so our map-generation patches see its results. -->
    <li>koth.RealisticPlanets2</li>
  </loadAfter>
  <description>Brings biological and geological rules to map generation, so plants grow where they would in nature: clustered, near water, or under the forest canopy.</description>
</ModMetaData>
