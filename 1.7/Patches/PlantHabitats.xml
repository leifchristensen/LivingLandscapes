<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!--
    Plant habitats (Docs/FLORA-REVIEW.md): what each wild plant of vanilla needs from the ground and the sky, as
    Gaussian response curves (optimum, tolerance = one standard deviation, in the layer's own units):
      wetness    LL_Moisture, 0 dry to 1 saturated        soilDepth  LL_SoilDepth, metres over bedrock
      slope      LL_Slope, rise over run (0.1 ~ 6 degrees) sun        LL_Sun, 0 sheltered to 1 sun-facing (level ground 0.7)
    A curve left out means the plant does not care. shadeTolerance: 0 fails in shade, 1 indifferent; shadeCast and
    shadeRadius (cells) make a plant shade the ground beneath it. Species not listed (modded or DLC) get defaults
    derived from vanilla's own plant fields. Clustering follows vanilla's wildClusterRadius and wildClusterWeight.
    Each entry is skipped if the plant is not installed.
  -->

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="Plant_Grass"]</xpath>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/ThingDef[defName="Plant_Grass"]</xpath>
      <value>
        <li Class="LivingLandscapes.Flora.PlantHabitat">
          <stratum>Ground</stratum>
          <wetness><optimum>0.45</optimum><tolerance>0.5</tolerance></wetness>
          <soilDepth><optimum>0.8</optimum><tolerance>1.2</tolerance></soilDepth>
          <sun><optimum>0.7</optimum><tolerance>0.6</tolerance></sun>
          <shadeTolerance>0.6</shadeTolerance>
        </li>
      </value>
    </match>
  </Operation>

