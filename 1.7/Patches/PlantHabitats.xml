<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!--
    Plant habitats (Docs/HABITAT-XML.md, PLANT-TRAITS.md): what each wild plant of vanilla needs, as Gaussian response
    curves (optimum, tolerance = one standard deviation):
      water   moisture 0 dry .. 1 saturated, drier on sun-facing slopes (PlantEcologyDef.sunDrying)
      light   LL_Sun x canopy transmittance: 0 dark .. 0.7 open level ground .. 1 sun-facing slope; saturating = no
              loss above the optimum (sun plants, photosynthesis saturates), otherwise strong light harms (shade plants)
    A curve left out means the plant does not care. rootingDepth (m): soil shallower than this limits the plant.
    pace (0 slow, stress tolerant .. 1 fast pioneer), seed (0 few large .. 1 many small) and dispersal (Gravity, Animal,
    Wind, Water, Clonal) describe its life strategy. shadeCast and shadeRadius (cells) make a plant shade the ground
    beneath it. Species not listed (modded or DLC) get defaults derived from vanilla's own plant fields.
    Each entry is skipped if the plant is not installed.
  -->

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="Plant_Grass"]</xpath>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/ThingDef[defName="Plant_Grass"]</xpath>
      <value>
        <li Class="LivingLandscapes.Flora.PlantHabitat">
          <stratum>Ground</stratum>
          <water><optimum>0.45</optimum><tolerance>0.5</tolerance></water>
          <light><optimum>0.68</optimum><tolerance>0.33</tolerance><saturating>true</saturating></light>
          <rootingDepth>0.3</rootingDepth>
          <pace>0.9</pace>
          <seed>0.9</seed>
          <dispersal>Wind</dispersal>
        </li>
      </value>
    </match>
  </Operation>

