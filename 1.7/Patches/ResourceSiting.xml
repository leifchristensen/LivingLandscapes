<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!--
    Where each vanilla ore lies (Docs/GAMEPLAY-PLAN.md, G2). Multipliers on the ore's vanilla commonality, by:
      rockStrength  LL_RockStrength at the lump, 0 soft bed .. 1 hard bed
      rockDepth     cells into the rock from its nearest open edge
      distance      cells from the settlement anchor (where the colony will start)
      patchScale    wavelength in cells of the ore's rich and poor patches; patchContrast 0 (even) .. 1 (only in rich patches)
    Each ore's overall share of the map stays vanilla's: its weight is rescaled to average 1 over the rock, so these only move it.
    Common ores favour the start and the rock's edge (reachable); rare ones lie deeper, in hard rock, and farther out.
    Ores left out (modded) are placed as vanilla does. Each entry is skipped if the ore is not installed.
  -->

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="MineableSteel"]</xpath>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/ThingDef[defName="MineableSteel"]</xpath>
      <value>
        <li Class="LivingLandscapes.Gameplay.ResourceSitingExtension">
          <rockDepth><points><li>(1,1.6)</li><li>(6,1)</li><li>(16,0.5)</li></points></rockDepth>
          <distance><points><li>(0,1.8)</li><li>(45,1.4)</li><li>(110,0.8)</li><li>(190,0.5)</li></points></distance>
          <patchScale>28</patchScale>
          <patchContrast>0.5</patchContrast>
        </li>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="MineableComponentsIndustrial"]</xpath>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/ThingDef[defName="MineableComponentsIndustrial"]</xpath>
      <value>
        <li Class="LivingLandscapes.Gameplay.ResourceSitingExtension">
          <rockDepth><points><li>(1,1.4)</li><li>(6,1)</li><li>(16,0.6)</li></points></rockDepth>
          <distance><points><li>(0,1.1)</li><li>(60,1.3)</li><li>(140,0.8)</li></points></distance>
          <patchScale>22</patchScale>
          <patchContrast>0.6</patchContrast>
        </li>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="MineableSilver"]</xpath>
