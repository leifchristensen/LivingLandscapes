          <rockDepth><points><li>(1,0.4)</li><li>(8,1)</li><li>(20,1.6)</li></points></rockDepth>
          <distance><points><li>(0,0.4)</li><li>(80,1)</li><li>(170,1.6)</li></points></distance>
