      <xpath>/Defs/ThingDef[defName="MineableSilver"]</xpath>
      <value>
        <li Class="LivingLandscapes.Gameplay.ResourceSitingExtension">
          <rockStrength><points><li>(0.2,0.6)</li><li>(0.6,1)</li><li>(1,1.4)</li></points></rockStrength>
          <rockDepth><points><li>(1,0.8)</li><li>(8,1.2)</li><li>(20,1)</li></points></rockDepth>
          <distance><points><li>(0,0.7)</li><li>(70,1)</li><li>(160,1.3)</li></points></distance>
          <patchScale>18</patchScale>
          <patchContrast>0.85</patchContrast>
        </li>
      </value>
    </match>
  </Operation>

