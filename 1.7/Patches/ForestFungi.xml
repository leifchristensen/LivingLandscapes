    <match Class="PatchOperationSequence">
      <operations>
      <li Class="PatchOperationAttributeAdd">
        <xpath>/Defs/ThingDef[defName="VPE_Plant_Stinker"]</xpath>
        <attribute>Name</attribute>
        <value>LL_VPE_Plant_Stinker_Source</value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs</xpath>
        <value>
          <ThingDef ParentName="LL_VPE_Plant_Stinker_Source">
            <defName>LL_ForestStinker</defName>
            <label>forest stinker</label>
            <description>A stinker of the deep forest floor: a small, fast-growing mushroom that forms patches in the litter under a closed canopy and gives off rotstink. Its fungus is edible. Strong light kills it.</description>
            <plant>
              <cavePlant>false</cavePlant>
              <cavePlantWeight>0</cavePlantWeight>
              <sowTags Inherit="False" />
            </plant>
            <modExtensions>
              <li Class="LivingLandscapes.Flora.PlantHabitat">
                <stratum>Ground</stratum>
                <water><optimum>0.75</optimum><tolerance>0.25</tolerance></water>
                <light><optimum>0.15</optimum><tolerance>0.08</tolerance></light>
                <lightLimit>0.3</lightLimit>
                <rootingDepth>0.1</rootingDepth>
                <pace>0.6</pace>
                <seed>0.9</seed>
                <dispersal>Wind</dispersal>
