<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!--
    Discoveries gather in interesting ground and lie farther from where the colony starts (Docs/GAMEPLAY-PLAN.md, G3).
    Adds a siting validator to vanilla scatterers: probability = LL_Interest^interestPower x distance curve (cells from the
    settlement anchor), never below floor. Counts stay vanilla's. Skipped for steps that are not installed.
  -->

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/GenStepDef[defName="ScatterShrines"]/genStep</xpath>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/GenStepDef[defName="ScatterShrines"]/genStep/validators</xpath>
      <match Class="PatchOperationAdd">
        <xpath>/Defs/GenStepDef[defName="ScatterShrines"]/genStep/validators</xpath>
        <value><li Class="LivingLandscapes.Gameplay.ScattererValidator_Siting"><interestPower>1.5</interestPower><distance><points><li>(0,0.2)</li><li>(50,0.6)</li><li>(110,1)</li></points></distance></li></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/GenStepDef[defName="ScatterShrines"]/genStep</xpath>
        <value><validators><li Class="LivingLandscapes.Gameplay.ScattererValidator_Siting"><interestPower>1.5</interestPower><distance><points><li>(0,0.2)</li><li>(50,0.6)</li><li>(110,1)</li></points></distance></li></validators></value>
      </nomatch>
    </match>
  </Operation>

