<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Ground rules (soil and surface rule S3): every cell takes the first rule whose conditions all hold
    (min inclusive, max exclusive). Fields: any environment layer by defName, plus RockDepth and RockDistance (metres
    into / to bare rock), WaterDistance (cells to surface water), Hollow (metres below a closed hollow's spill level), HollowCells (size of that hollow)
    Climate (0..1 from tile rainfall) and Marshland (0..1 from the map's water regime: a wetland's damp ground is marsh). elevation is the value written into vanilla's elevation grid
    (> 0.798 overhead mountain, > 0.728 thin roof, > 0.70 rock wall, 0.61-0.70 rough stone, 0.55-0.61 gravel,
    below that soil chosen by fertility). cover places water, marsh or mud.
  -->
  <LivingLandscapes.Geology.GroundRulesDef>
    <defName>LL_GroundRules</defName>
    <label>ground rules</label>
    <rules>
      <li>
        <label>deep water</label>
        <conditions>
          <li><field>LL_SurfaceWater</field><min>0.5</min></li>
          <li><field>LL_WaterFlow</field><max>0.01</max></li>
        </conditions>
        <cover>DeepWater</cover>
      </li>
      <li>
        <label>deep moving water</label>
        <conditions>
          <li><field>LL_SurfaceWater</field><min>0.85</min></li>
        </conditions>
        <cover>DeepMovingWater</cover>
      </li>
      <li>
        <label>stream</label>
        <conditions>
          <li><field>LL_SurfaceWater</field><min>0.01</min></li>
          <li><field>LL_WaterFlow</field><min>0.01</min></li>
        </conditions>
        <cover>ShallowMovingWater</cover>
      </li>
      <li>
        <label>shallow water</label>
        <conditions>
          <li><field>LL_SurfaceWater</field><min>0.01</min></li>
        </conditions>
        <cover>ShallowWater</cover>
      </li>
      <li>
        <label>overhead mountain</label>
        <conditions>
          <li><field>RockDepth</field><min>7</min></li>
        </conditions>
        <elevation>0.82</elevation>
      </li>
      <li>
        <label>mountain</label>
        <conditions>
          <li><field>RockDepth</field><min>4</min></li>
        </conditions>
        <elevation>0.75</elevation>
      </li>
      <li>
        <label>bare rock</label>
        <conditions>
          <li><field>RockDepth</field><min>0.5</min></li>
        </conditions>
        <elevation>0.65</elevation>
      </li>
      <li>
        <label>outcrop</label>
        <conditions>
          <li><field>LL_SoilDepth</field><max>0.3</max></li>
          <li><field>LL_RockStrength</field><min>0.5</min></li>
        </conditions>
        <elevation>0.65</elevation>
      </li>
      <!-- Playa: a closed hollow on a dry tile holds no lake (evaporation wins); its flat, barren floor is a dry lake bed. -->
      <li>
        <label>playa</label>
        <conditions>
          <li><field>Hollow</field><min>0.1</min></li>
          <li><field>HollowCells</field><min>200</min></li>
          <li><field>Climate</field><max>0.35</max></li>
        </conditions>
        <cover>Playa</cover>
      </li>
      <li>
        <label>marsh</label>
        <conditions>
          <li><field>LL_Wetness</field><min>0.88</min></li>
          <li><field>Climate</field><min>0.5</min></li>
        </conditions>
        <cover>Marsh</cover>
      </li>
      <li>
        <label>wetland marsh</label>
        <conditions>
          <li><field>Marshland</field><min>0.5</min></li>
          <li><field>LL_Wetness</field><min>0.45</min></li>
        </conditions>
        <cover>Marsh</cover>
      </li>
      <li>
        <label>hollow marsh</label>
        <conditions>
          <li><field>Hollow</field><min>0.1</min></li>
          <li><field>Climate</field><min>0.4</min></li>
        </conditions>
        <cover>Marsh</cover>
      </li>
      <li>
        <label>mud</label>
        <conditions>
          <li><field>LL_Wetness</field><min>0.8</min></li>
        </conditions>
        <cover>Mud</cover>
      </li>
      <li>
        <label>shore mud</label>
        <conditions>
          <li><field>WaterDistance</field><max>1.5</max></li>
          <li><field>LL_Wetness</field><min>0.6</min></li>
        </conditions>
        <cover>Mud</cover>
      </li>
      <!-- Alluvium (Docs/SEDIMENT-PLAN.md): what the rivers laid down, by grain size. Gravel bars by the water, sandy
           banks and levees, fine fertile floodplain soil farther out. Back swamps are caught by the marsh and mud rules above. -->
      <li>
        <label>gravel bar</label>
        <conditions>
          <li><field>LL_Alluvium</field><min>0.15</min></li>
          <li><field>LL_GrainSize</field><min>0.5</min></li>
          <li><field>WaterDistance</field><max>2.5</max></li>
        </conditions>
        <cover>Gravel</cover>
      </li>
      <li>
        <label>sandy bank</label>
        <conditions>
          <li><field>LL_Alluvium</field><min>0.15</min></li>
          <li><field>LL_GrainSize</field><min>0.33</min></li>
          <li><field>WaterDistance</field><max>5</max></li>
        </conditions>
        <cover>Sand</cover>
      </li>
      <li>
        <label>alluvial soil</label>
        <conditions>
          <li><field>LL_Alluvium</field><min>0.5</min></li>
          <li><field>LL_GrainSize</field><max>0.33</max></li>
        </conditions>
        <cover>RichSoil</cover>
      </li>
      <li>
        <label>scree</label>
        <conditions>
          <li><field>LL_Debris</field><min>1</min></li>
        </conditions>
        <elevation>0.58</elevation>
      </li>
      <li>
        <label>dry wash</label>
        <conditions>
          <li><field>Climate</field><max>0.3</max></li>
          <li><field>LL_DrainageArea</field><min>2.4</min></li>
        </conditions>
        <elevation>0.58</elevation>
      </li>
      <li>
        <label>wash</label>
        <conditions>
          <li><field>Climate</field><max>0.6</max></li>
          <li><field>LL_DrainageArea</field><min>2.8</min></li>
        </conditions>
        <elevation>0.58</elevation>
      </li>
      <li>
        <label>soil</label>
        <elevation>0.3</elevation>
      </li>
    </rules>
  </LivingLandscapes.Geology.GroundRulesDef>

</Defs>
