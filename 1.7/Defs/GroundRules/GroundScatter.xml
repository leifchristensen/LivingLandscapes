<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Loose material on the ground (Geology/GroundScatter.cs), placed after plants. Conditions test environment layers.
       thing: a ThingDef defName (skipped if not installed) or LocalRockChunk (a chunk of the nearest rock).
       biomes limits a rule to biomes; patchScale and patchShare gather it into fields. -->
  <LivingLandscapes.Geology.GroundScatterDef>
    <defName>LL_GroundScatter</defName>
    <rules>
      <!-- Gravel bars: the coarsest alluvium carries cobbles and boulders. -->
      <li>
        <label>chunks on gravel bars</label>
        <conditions>
          <li><field>LL_GrainSize</field><min>0.55</min></li>
          <li><field>LL_Alluvium</field><min>0.15</min></li>
        </conditions>
        <terrains><li>Gravel</li></terrains>
        <thing>LocalRockChunk</thing>
        <chance>0.06</chance>
      </li>
      <!-- Small stones from Scattered Stones (Owlchemist.ScatteredStones), when it is installed. -->
      <li>
        <label>stones on gravel bars</label>
        <conditions>
          <li><field>LL_GrainSize</field><min>0.5</min></li>
          <li><field>LL_Alluvium</field><min>0.15</min></li>
        </conditions>
        <terrains><li>Gravel</li></terrains>
        <thing>Owl_Filth_Rocks</thing>
        <chance>0.35</chance>
        <tintWithRock>true</tintWithRock>
      </li>
      <!-- Rockfall: boulders gather where debris from rock faces comes to rest (below cliffs, at the foot of mountains), giving
           cover and stone where the ground rises and little in the open lowlands. -->
      <li>
        <label>rockfall boulders</label>
        <conditions>
          <li><field>LL_Debris</field><min>0.3</min></li>
        </conditions>
        <thing>LocalRockChunk</thing>
        <chance>0.1</chance>
      </li>
      <!-- Rocky slopes: thin soil on sloping ground beside bare rock carries scattered blocks, in patches. -->
      <li>
        <label>blocks on rocky slopes</label>
        <conditions>
          <li><field>LL_SoilDepth</field><max>0.3</max></li>
          <li><field>LL_Slope</field><min>0.15</min></li>
        </conditions>
        <thing>LocalRockChunk</thing>
        <chance>0.05</chance>
        <patchScale>15</patchScale>
        <patchShare>0.45</patchShare>
      </li>
      <!-- Boulder fields (#51 option 5): glacial erratics strewn over gentle ground in once-glaciated country, in fields. -->
      <li>
        <label>glacial erratics</label>
        <conditions>
          <li><field>LL_Slope</field><max>0.35</max></li>
        </conditions>
        <biomes><li>BorealForest</li><li>Tundra</li><li>ColdBog</li><li>IceSheet</li></biomes>
        <thing>LocalRockChunk</thing>
        <chance>0.05</chance>
        <patchScale>30</patchScale>
        <patchShare>0.2</patchShare>
      </li>
    </rules>
  </LivingLandscapes.Geology.GroundScatterDef>

</Defs>
