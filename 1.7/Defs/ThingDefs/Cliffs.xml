<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Terrace steps: the quick way between height stages, in the gaps of the cliff bands. Made of the local rock and
    taking its colour and name. Art: placeholder from Source/Tools/generate_cliff_art.py.
  -->

  <ThingDef Name="LL_TerraceBase" ParentName="BuildingNaturalBase" Abstract="True">
    <thingClass>LivingLandscapes.Geology.Building_Cliff</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <saveCompressible>true</saveCompressible>
    <fertility>0</fertility>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <building>
      <isInert>true</isInert>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <canBuildNonEdificesUnder>false</canBuildNonEdificesUnder>
      <destroyShakeAmount>0</destroyShakeAmount>
    </building>
  </ThingDef>

  <!--
    Cliff bands are Decorative Cliffs' stone cliffs (Stone_Cliff_Left/Right, Stone_CliffTop_Left), spawned from the
    local rock's blocks so they link into lines; see LivingLandscapes.Geology.CliffDefs.
  -->

  <!-- Rough steps between stages; faces downhill. Registers the cliff link so bands join onto it. -->
  <ThingDef ParentName="LL_TerraceBase">
    <defName>LL_CliffSteps</defName>
    <label>rock steps</label>
    <description>Rough steps in the edge of a rise, the easy way between the higher and lower ground.</description>
    <graphicData>
      <texPath>Things/Building/LivingLandscapes/Terrace/CliffSteps</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <linkFlags>
        <li>Custom2</li>
      </linkFlags>
    </graphicData>
    <rotatable>true</rotatable>
    <passability>Standable</passability>
    <pathCost>6</pathCost>
    <fillPercent>0</fillPercent>
  </ThingDef>

</Defs>
