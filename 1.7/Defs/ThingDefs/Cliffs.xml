<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Cliffs: placed by the geology on the higher side of every height change, drawn as thin edges on the sides that drop
    to lower ground (LivingLandscapes.Geology.Building_Cliff; art from Source/ArtTools/generate_cliff_art.py), tinted
    with the local rock and named after it ("granite cliff"). Bands can be climbed, very slowly, and give cover without
    blocking the view; steps are the quick way up.
  -->

  <ThingDef Name="LL_CliffBase" ParentName="BuildingNaturalBase" Abstract="True">
    <thingClass>LivingLandscapes.Geology.Building_Cliff</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <graphicData>
      <texPath>Things/Building/LivingLandscapes/Cliff/Edge_South</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <useHitPoints>false</useHitPoints>
    <saveCompressible>false</saveCompressible>
    <rotatable>true</rotatable>
    <fertility>0</fertility>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <building>
      <isInert>true</isInert>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <canBuildNonEdificesUnder>false</canBuildNonEdificesUnder>
      <destroyShakeAmount>0</destroyShakeAmount>
    </building>
  </ThingDef>

  <ThingDef ParentName="LL_CliffBase">
    <defName>LL_Cliff</defName>
    <label>cliff</label>
    <description>A steep rise in the ground. It can be climbed, very slowly, and gives some cover without blocking the view; steps along it are quicker.</description>
    <passability>PassThroughOnly</passability>
    <pathCost>400</pathCost>
    <pathCostIgnoreRepeat>false</pathCostIgnoreRepeat>
    <fillPercent>0.45</fillPercent>
  </ThingDef>

  <ThingDef ParentName="LL_CliffBase">
    <defName>LL_CliffSteps</defName>
    <label>rock steps</label>
    <description>Rough steps in the edge of a rise, the easy way between the higher and lower ground.</description>
    <passability>Standable</passability>
    <pathCost>6</pathCost>
    <fillPercent>0</fillPercent>
  </ThingDef>

</Defs>
