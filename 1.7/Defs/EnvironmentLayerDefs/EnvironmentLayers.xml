<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Per-cell environment layers. Each is computed once at map generation, in dependency order, and saved with the
    map. <overlay> controls the dev-mode overlay and PNG export: a colour ramp (layer units), optional flat
    hypsometric bands, contour interval, and every n-th contour as a thicker, labelled index line.
  -->

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_Elevation</defName>
    <label>vanilla elevation</label>
    <description>Vanilla map-generation elevation, as generated (noise; lakes flattened to 0, rivers -1). Rock forms above 0.7; lakes are carved below 0.</description>
    <workerClass>LivingLandscapes.Layers.ElevationWorker</workerClass>
    <precision>UShort</precision>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <!--
    Geology: one height surface, metres above sea level, that all downstream layers read.
    Geological terrain on: generated from geological principles and used to place rock, scree and soil.
    Off: inferred from the terrain vanilla placed. A map cell is about 1 m (a twin bed is 2 x 1 cells).
  -->

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_Landform</defName>
    <label>topology</label>
    <description>The natural ground surface in metres above sea level, as erosion shaped it, before terracing. Soil and mountain rock follow it.</description>
    <workerClass>LivingLandscapes.Layers.LandformWorker</workerClass>
    <precision>UShort</precision>
    <unit>m</unit>
    <dependsOn>
      <li>LL_Elevation</li>
    </dependsOn>
    <overlay>
      <icon>UI/LivingLandscapes/Overlays/Topology</icon>
      <banded>true</banded>
      <relativeColors>true</relativeColors>
      <!-- Colour bands are a fixed 25 m on absolute multiples of 25, so their edges are the thick contour lines (#190).
           The ramp below is sampled as a 7-colour palette; maps with more bands interpolate between those. -->
      <bandInterval>25</bandInterval>
      <!-- Thin contour line every 5 m on every map, thick (index, labelled) every 5th = every 25 m. Fixed rather than by
           relief class (#89 table) at the owner's request: line density then shows steepness identically everywhere. -->
      <contourInterval>5</contourInterval>
      <indexEvery>5</indexEvery>
      <labelFormat>0.#</labelFormat>
      <colors>
        <li><value>0</value><color>(0.30, 0.58, 0.32)</color></li>
        <li><value>0.2</value><color>(0.55, 0.76, 0.40)</color></li>
        <li><value>0.4</value><color>(0.90, 0.88, 0.52)</color></li>
        <li><value>0.6</value><color>(0.93, 0.74, 0.47)</color></li>
        <li><value>0.8</value><color>(0.70, 0.48, 0.33)</color></li>
        <li><value>1</value><color>(0.92, 0.91, 0.90)</color></li>
      </colors>
    </overlay>
    <modExtensions>
      <li Class="LivingLandscapes.Geology.GeologyGenerationExtension">
        <!-- Channels from drainage (TerrainChannels). The ground absorbs rain first: runoff = (climate wetness -
             absorption) / (1 - absorption), by biome. Drainage lines are seeps until their water exceeds what the
             saturated ground carries (seepCapacityWidth at the median slope, more on gentle ground: channel heads); the
             channel carries the excess, so it starts one cell wide. Seeps are marsh, mud, or a damp or dry bed by how
             much water they gather. On a tile without
             a world river the map's water is vanilla's world flow through the tile as a share of a creek's. Channels lose
             water into their bed (transmissionLoss x the biome's absorption, per cell of length and width). -->
        <terrainChannels>
          <transmissionLoss>6</transmissionLoss>
          <absorption>0.3</absorption>
          <seepCapacityWidth>2</seepCapacityWidth>
          <!-- Standing water needs the level to lie this much (metres) deeper above the bed than the channel is deep. -->
          <standingTolerance>0.05</standingTolerance>
          <biomeAbsorption>
            <li><biome>TemperateSwamp</biome><absorption>0</absorption></li>
            <li><biome>TropicalSwamp</biome><absorption>0</absorption></li>
            <li><biome>ColdBog</biome><absorption>0</absorption></li>
            <li><biome>Tundra</biome><absorption>0.1</absorption></li>
            <li><biome>IceSheet</biome><absorption>0.1</absorption></li>
            <li><biome>TropicalRainforest</biome><absorption>0.3</absorption></li>
            <li><biome>BorealForest</biome><absorption>0.3</absorption></li>
            <li><biome>TemperateForest</biome><absorption>0.4</absorption></li>
            <li><biome>AridShrubland</biome><absorption>0.5</absorption></li>
            <li><biome>Desert</biome><absorption>0.6</absorption></li>
            <li><biome>ExtremeDesert</biome><absorption>0.7</absorption></li>
          </biomeAbsorption>
        </terrainChannels>
        <cellSize>1</cellSize>
        <strata>
          <bedThickness>8~30</bedThickness>
          <dip>5~35</dip>
          <!-- How the beds lie by the tile's hilliness. Near-horizontal beds outcrop along the contours, so the bands of rock
               read like a topographic map; bedsAcrossRelief sets how many bands the relief shows. Steep tilts (straight
               stripes, hogbacks) only on rugged tiles and only sometimes (steepChance). First pass, to be tuned by eye. -->
          <byHilliness>
            <li><hilliness>Flat</hilliness><dip>0~1</dip><bedsAcrossRelief>3~4</bedsAcrossRelief></li>
            <li><hilliness>SmallHills</hilliness><dip>0~2</dip><bedsAcrossRelief>6~8</bedsAcrossRelief><intrusionShare>0.02</intrusionShare></li>
            <li><hilliness>LargeHills</hilliness><dip>0~4</dip><steepChance>0.1</steepChance><bedsAcrossRelief>10~14</bedsAcrossRelief><intrusionShare>0.06</intrusionShare></li>
            <li><hilliness>Mountainous</hilliness><dip>2~8</dip><steepChance>0.3</steepChance><steepDip>20~45</steepDip><bedsAcrossRelief>14~20</bedsAcrossRelief><intrusionShare>0.1</intrusionShare></li>
            <li><hilliness>Impassable</hilliness><dip>3~10</dip><steepChance>0.4</steepChance><steepDip>25~50</steepDip><bedsAcrossRelief>18~24</bedsAcrossRelief><intrusionShare>0.14</intrusionShare></li>
          </byHilliness>
          <warpAmplitude>12</warpAmplitude>
          <warpScale>60</warpScale>
          <jointSpacing>25~45</jointSpacing>
          <jointWidth>2</jointWidth>
          <jointWeakness>0.35</jointWeakness>
          <strengthJitter>0.15</strengthJitter>
          <softBedChance>0.4</softBedChance>
          <softBedFactor>0.45</softBedFactor>
          <openJoints>0.5</openJoints>
          <contrast>2</contrast>
        </strata>
        <reliefFlat>4</reliefFlat>
        <reliefSmallHills>20</reliefSmallHills>
        <reliefLargeHills>70</reliefLargeHills>
        <reliefMountainous>180</reliefMountainous>
        <reliefImpassable>300</reliefImpassable>
        <tileSpacingMetres>30000</tileSpacingMetres>
        <!-- Share of the fall to a neighbour of the same hilliness the map inherits as its regional slope. Each
             neighbour's fall counts by the relief contrast of the two tiles (|r1 - r2| / max, from the relief values
             above): a plain beside hills slopes off them, a plain among plains takes no tilt and drains by its own
             relief. The sea and a world river keep their pull. -->
        <uniformSlopeShare>0</uniformSlopeShare>
        <landformWavelength>300</landformWavelength>
        <landformWavelengthFlat>125</landformWavelengthFlat>
        <landformWavelengthSmallHills>200</landformWavelengthSmallHills>
        <detailWavelength>100</detailWavelength>
        <detailUplift>0.3</detailUplift>
        <ridgedness>0.2</ridgedness>
        <ridgednessMountains>0.6</ridgednessMountains>
        <erosionCellSize>2</erosionCellSize>
        <regionScale>2.5</regionScale>
        <erosionIterations>120</erosionIterations>
        <erodibility>0.05</erodibility>
        <areaExponent>0.5</areaExponent>
        <hillslopeDiffusion>0.12</hillslopeDiffusion>
        <regionalUpliftBias>0.5</regionalUpliftBias>
        <riverInflow>8</riverInflow>
        <!-- Channel network (rules V1-V3): channels first, valleys follow; widths compressed to map scale. -->
        <network>
          <sourceShare>0.02</sourceShare>
          <minLengthInside>20</minLengthInside>
          <!-- Vanilla width by class (creek 4, river 6, large 14, huge 30) to map width. -->
          <worldRiverWidth>
            <points>
              <li>(4, 3)</li>
              <li>(6, 6)</li>
              <li>(14, 12)</li>
              <li>(30, 24)</li>
            </points>
          </worldRiverWidth>
        </network>
        <microRelief>0.3</microRelief>
        <microWavelength>6</microWavelength>
      </li>
      <li Class="LivingLandscapes.Geology.HeightInferenceExtension">
        <smoothingSigma>2.5</smoothingSigma>
        <basinDepth>0.12</basinDepth>
        <basinReach>18</basinReach>
        <wetBasinFactor>0.5</wetBasinFactor>
        <shoreDrop>0.01</shoreDrop>
        <riverIncision>0.04</riverIncision>
        <riverGradientPerCell>0.0006</riverGradientPerCell>
        <rockThreshold>0.7</rockThreshold>
        <rockEdgeSigma>1</rockEdgeSigma>
        <maxBreachDepth>0.06</maxBreachDepth>
        <drainageEpsilon>0.00005</drainageEpsilon>
      </li>
    </modExtensions>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_Height</defName>
    <label>height</label>
    <description>Walkable ground height in metres above sea level. With geological terrain on, the landform stepped into stages of level ground with cliffs at their edges.</description>
    <workerClass>LivingLandscapes.Layers.HeightWorker</workerClass>
    <precision>UShort</precision>
    <unit>m</unit>
    <dependsOn>
      <li>LL_Landform</li>
      <li>LL_RockStage</li>
      <li>LL_Slope</li>
    </dependsOn>
    <modExtensions>
      <li Class="LivingLandscapes.Geology.TerraceExtension">
        <stagesAcrossRelief>12</stagesAcrossRelief>
        <minStageHeight>6</minStageHeight>
        <treadRise>0.2</treadRise>
        <knobMaxCells>150</knobMaxCells>
        <gentleSlope>0</gentleSlope>
        <cliffSlope>0.5</cliffSlope>
        <steepnessSmoothing>2</steepnessSmoothing>
        <scarpTraceSteepness>0.25</scarpTraceSteepness>
        <scarpMinLength>12</scarpMinLength>
      </li>
    </modExtensions>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_RockStrength</defName>
    <label>rock strength</label>
    <description>Strength of the rock beneath the ground, 0 to 1: tilted beds of the tile's rock types, weakened along joints. Hard beds stand as ridges and narrows; soft beds wear into valleys. Only with geological terrain on.</description>
    <workerClass>LivingLandscapes.Layers.RockStrengthWorker</workerClass>
    <precision>Byte</precision>
    <dependsOn>
      <li>LL_Landform</li>
    </dependsOn>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_RockStage</defName>
    <label>rock stage</label>
    <description>Hard beds below each cell's surface: the count of resistant rock beds the ground has been cut down through. The terrace stages follow it. Only with geological terrain on.</description>
    <workerClass>LivingLandscapes.Layers.RockStageWorker</workerClass>
    <dependsOn>
      <li>LL_Landform</li>
    </dependsOn>
    <overlay>
      <toggle>false</toggle>
      <labelFormat>0</labelFormat>
      <fillOpacity>0.6</fillOpacity>
      <colors>
        <li><value>0</value><color>(0.85, 0.85, 0.9, 0.1)</color></li>
        <li><value>2</value><color>(0.6, 0.55, 0.7, 0.5)</color></li>
        <li><value>6</value><color>(0.3, 0.2, 0.45, 0.85)</color></li>
      </colors>
    </overlay>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_Erodibility</defName>
    <label>erodibility</label>
    <description>How readily the ground wears under flowing water (K in the stream-power law): the landform's factor times the exposed rock bed's. 1 is average rock, higher is weak rock that cuts fast. Only with geological terrain on.</description>
    <workerClass>LivingLandscapes.Layers.ErodibilityWorker</workerClass>
    <dependsOn>
      <li>LL_Landform</li>
    </dependsOn>
    <overlay>
      <toggle>false</toggle>
      <labelFormat>0.0</labelFormat>
      <fillOpacity>0.6</fillOpacity>
      <colors>
        <li><value>0</value><color>(0.25, 0.25, 0.3, 0.8)</color><label>hard rock</label></li>
        <li><value>1</value><color>(0.8, 0.75, 0.6, 0.4)</color><label>average</label></li>
        <li><value>3</value><color>(0.85, 0.45, 0.2, 0.85)</color><label>weak rock</label></li>
      </colors>
    </overlay>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_Deposition</defName>
    <label>deposition</label>
    <description>Metres of deposit the erosion model's rivers left standing in the landform, regionally: where the load slows and drops. The model-scale cousin of alluvium, which is the thin channel-scale layer laid on top of it; the two are not the same material and are not summed.</description>
    <workerClass>LivingLandscapes.Layers.DepositionWorker</workerClass>
    <precision>UShort</precision>
    <unit>m</unit>
    <dependsOn>
      <li>LL_Landform</li>
    </dependsOn>
    <overlay>
      <toggle>false</toggle>
      <labelFormat>0.0</labelFormat>
      <fillOpacity>0.75</fillOpacity>
      <colors>
        <li><value>0</value><color>(0.9, 0.8, 0.5, 0)</color></li>
        <li><value>1</value><color>(0.9, 0.8, 0.5, 0.4)</color></li>
        <li><value>10</value><color>(0.55, 0.35, 0.15, 0.95)</color></li>
      </colors>
    </overlay>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_SoilDepth</defName>
    <label>soil depth</label>
    <description>Depth of soil over bedrock. Thin on steep ground and crests, deep in hollows and valley floors; bedrock is exposed where none remains.</description>
    <workerClass>LivingLandscapes.Layers.SoilDepthWorker</workerClass>
    <unit>m</unit>
    <dependsOn>
      <li>LL_Landform</li>
      <li>LL_RockStrength</li>
      <li>LL_Alluvium</li>
      <li>LL_Slope</li>
    </dependsOn>
    <overlay>
      <icon>UI/LivingLandscapes/Overlays/SoilDepth</icon>
      <labelFormat>0.0</labelFormat>
      <colors>
        <li><value>0</value><color>(0.45, 0.45, 0.48)</color></li>
        <li><value>0.3</value><color>(0.75, 0.70, 0.55)</color></li>
        <li><value>1</value><color>(0.60, 0.50, 0.30)</color></li>
        <li><value>2.4</value><color>(0.30, 0.22, 0.12)</color></li>
      </colors>
    </overlay>
    <modExtensions>
      <li Class="LivingLandscapes.Geology.SoilModelExtension">
        <baseSoilDepth>1.2</baseSoilDepth>
        <bareRockSlope>0.84</bareRockSlope>
        <hollowBonus>1.0</hollowBonus>
        <crestLoss>0.5</crestLoss>
        <soilOnWeakRock>1.5</soilOnWeakRock>
        <soilOnStrongRock>0.3</soilOnStrongRock>
        <bareSlopeOnWeakRock>1.3</bareSlopeOnWeakRock>
        <bareSlopeOnStrongRock>0.5</bareSlopeOnStrongRock>
        <rockWallDepth>0.15</rockWallDepth>
        <!-- Flat land is mostly soil: its rock comes from a plains feature (owner 2026-10-21: flat maps had too much rock). -->
        <rockShareFlat>0.01~0.04</rockShareFlat>
      </li>
    </modExtensions>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_Debris</defName>
    <label>rock debris</label>
    <description>Rock fragments shed by bare rock faces, collected where they come to rest as the slope eases: the number of faces feeding each cell. Scree lies where it is high.</description>
    <workerClass>LivingLandscapes.Layers.DebrisWorker</workerClass>
    <dependsOn>
      <li>LL_Landform</li>
      <li>LL_SoilDepth</li>
      <li>LL_Slope</li>
    </dependsOn>
    <overlay>
      <icon>UI/LivingLandscapes/Overlays/Debris</icon>
      <labelFormat>0.0</labelFormat>
      <fillOpacity>0.75</fillOpacity>
      <colors>
        <li><value>0</value><color>(0.6, 0.6, 0.6, 0)</color></li>
        <li><value>1</value><color>(0.6, 0.55, 0.5, 0.6)</color></li>
        <li><value>10</value><color>(0.3, 0.25, 0.2, 1)</color></li>
      </colors>
    </overlay>
    <modExtensions>
      <li Class="LivingLandscapes.Layers.DebrisExtension">
        <faceSlope>0.5</faceSlope>
        <restSlope>0.25</restSlope>
        <maxRun>40</maxRun>
        <spread>1.5</spread>
      </li>
    </modExtensions>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_DrainageArea</defName>
    <label>drainage area</label>
    <description>Upslope area draining through each cell (log10 of cells): 0 on ridges, high along gullies and valley floors.</description>
    <workerClass>LivingLandscapes.Layers.DrainageAreaWorker</workerClass>
    <dependsOn>
      <li>LL_Landform</li>
    </dependsOn>
    <unit>log10 cells</unit>
    <overlay>
      <!-- No map toggle (#139): water flow and surface water show the channels. Kept for the PNG export. -->
      <toggle>false</toggle>
      <labelFormat>0.0</labelFormat>
      <fillOpacity>0.65</fillOpacity>
      <colors>
        <li><value>0</value><color>(0.95, 0.93, 0.85)</color></li>
        <li><value>1.5</value><color>(0.80, 0.85, 0.70)</color></li>
        <li><value>2.5</value><color>(0.45, 0.70, 0.85)</color></li>
        <li><value>3.5</value><color>(0.15, 0.40, 0.85)</color></li>
        <li><value>4.8</value><color>(0.05, 0.10, 0.45)</color></li>
      </colors>
    </overlay>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_SpillDepth</defName>
    <label>spill depth</label>
    <description>How deep a closed hollow could hold water before it spills on: 0 outside hollows. Whether it does depends on rain and evaporation.</description>
    <workerClass>LivingLandscapes.Layers.SpillDepthWorker</workerClass>
    <dependsOn>
      <li>LL_Landform</li>
    </dependsOn>
    <unit>m</unit>
    <overlay>
      <!-- No map toggle (#139): surface water shows the lakes that formed. Kept for the PNG export. -->
      <toggle>false</toggle>
      <labelFormat>0.0</labelFormat>
      <fillOpacity>0.65</fillOpacity>
      <colors>
        <li><value>0</value><color>(1, 1, 1, 0)</color></li>
        <li><value>0.1</value><color>(0.70, 0.85, 0.95)</color></li>
        <li><value>1</value><color>(0.35, 0.60, 0.90)</color></li>
        <li><value>5</value><color>(0.05, 0.20, 0.60)</color></li>
      </colors>
    </overlay>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_HeightAboveDrainage</defName>
    <label>height above drainage</label>
    <description>Height above the nearest stream, river or full hollow that a cell's water reaches: low ground beside drainage has its water table near the surface.</description>
    <workerClass>LivingLandscapes.Layers.HeightAboveDrainageWorker</workerClass>
    <dependsOn>
      <li>LL_Landform</li>
      <li>LL_Alluvium</li>
      <li>LL_GrainSize</li>
      <li>LL_SoilDepth</li>
    </dependsOn>
    <unit>m</unit>
    <overlay>
      <!-- No map toggle (#139): moisture is its gameplay result. Kept for the PNG export. -->
      <toggle>false</toggle>
      <labelFormat>0.0</labelFormat>
      <fillOpacity>0.65</fillOpacity>
      <colors>
        <li><value>0</value><color>(0.10, 0.35, 0.80)</color></li>
        <li><value>2</value><color>(0.55, 0.80, 0.85)</color></li>
        <li><value>8</value><color>(0.90, 0.88, 0.75)</color></li>
        <li><value>30</value><color>(0.75, 0.55, 0.35)</color></li>
      </colors>
    </overlay>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_Slope</defName>
    <label>slope</label>
    <description>Steepness of the ground, rise over run (0.1 is about 6 degrees, 1 is 45). Drawn as arrows pointing downhill; longer and redder is steeper.</description>
    <workerClass>LivingLandscapes.Layers.SlopeWorker</workerClass>
    <dependsOn>
      <li>LL_Landform</li>
    </dependsOn>
    <overlay>
      <!-- No map toggle (#139): walking effort is its gameplay effect. Kept for the PNG export. -->
      <toggle>false</toggle>
      <relativeColors>true</relativeColors>
      <contourInterval>0</contourInterval>
      <fillOpacity>0.8</fillOpacity>
      <directionLayer>LL_Aspect</directionLayer>
      <labelFormat>0.00</labelFormat>
      <colors>
        <li><value>0</value><color>(1.0, 1.0, 1.0, 0.0)</color></li>
        <li><value>0.5</value><color>(1.0, 0.5, 0.3, 0.5)</color></li>
        <li><value>1</value><color>(0.8, 0.1, 0.1, 1.0)</color></li>
      </colors>
    </overlay>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_Aspect</defName>
    <label>slope aspect</label>
    <description>Downhill direction of the ground in radians, counter-clockwise from east (0 east, 1.57 north, 3.14 west, 4.71 south).</description>
    <workerClass>LivingLandscapes.Layers.AspectWorker</workerClass>
    <dependsOn>
      <li>LL_Landform</li>
    </dependsOn>
    <overlay>
      <!-- No map toggle (#139): sun exposure is its gameplay effect. Kept for the PNG export. -->
      <toggle>false</toggle>
      <!-- Aspect means something only where the ground slopes: colour fades out on level ground (owner playtest 2026-11-02). -->
      <opacityLayer>LL_Slope</opacityLayer>
      <opacityRange>0~0.5</opacityRange>
      <labelFormat>0.00</labelFormat>
      <colors>
        <li><value>0</value><color>(1.00, 0.00, 0.00)</color><label>faces east</label></li>
        <li><value>1.57</value><color>(0.00, 1.00, 0.00)</color><label>faces north</label></li>
        <li><value>3.14</value><color>(0.00, 0.00, 1.00)</color><label>faces west</label></li>
        <li><value>4.71</value><color>(1.00, 0.00, 1.00)</color><label>faces south</label></li>
        <li><value>6.28</value><color>(1.00, 0.00, 0.00)</color><label>faces east</label></li>
      </colors>
    </overlay>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_Wetness</defName>
    <label>wetness</label>
    <description>0 (dry) to 1 (wet): where water collects and the water table is near the surface, from drainage area, slope and height above the nearest drainage line; sharper on dry tiles. Drives soil fertility and wet ground.</description>
    <workerClass>LivingLandscapes.Layers.WetnessWorker</workerClass>
    <precision>Byte</precision>
    <dependsOn>
      <li>LL_Landform</li>
      <li>LL_DrainageArea</li>
      <li>LL_Alluvium</li>
      <li>LL_GrainSize</li>
      <li>LL_SoilDepth</li>
    </dependsOn>
    <modExtensions>
      <li Class="LivingLandscapes.Layers.WetnessExtension">
        <slopeSmoothing>2</slopeSmoothing>
        <channelArea>2.5</channelArea>
        <heightAboveDrainageScale>2</heightAboveDrainageScale>
        <wetnessIndexRange>4~13</wetnessIndexRange>
        <wetnessIndexWeight>0.5</wetnessIndexWeight>
        <wetRainfallMm>1500</wetRainfallMm>
        <aridSharpening>3</aridSharpening>
        <unknownRainfall>0.4</unknownRainfall>
      </li>
      <li Class="LivingLandscapes.Geology.GroundWriterExtension">
        <fertilityWetness>0.55</fertilityWetness>
        <fertilitySoilDepth>0.35</fertilitySoilDepth>
        <fertilityNoise>0.1</fertilityNoise>
        <deepSoil>2</deepSoil>
        <!-- Throughflow enrichment (#187, Geology/Throughflow.cs): moving water in saturated subsoil along drainage lines. -->
        <fertilityThroughflow>1.4</fertilityThroughflow>
        <richSoilScale>1.5</richSoilScale>
        <throughflowAreaMin>0.5</throughflowAreaMin>
        <throughflowAreaFull>2.5</throughflowAreaFull>
        <throughflowMovingGradient>0.03</throughflowMovingGradient>
        <throughflowReachHeight>2.5</throughflowReachHeight>
        <throughflowProfileSigma>2</throughflowProfileSigma>
        <throughflowProfileRange>0.3</throughflowProfileRange>
        <throughflowThinning>0.85</throughflowThinning>
      </li>
    </modExtensions>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_SurfaceWater</defName>
    <label>surface water</label>
    <description>Depth of standing and flowing water in metres, from the landform: lakes fill closed hollows to the level where rain on their catchment balances evaporation; streams run where enough ground drains, wider the more it drains. Terrain, cliffs and plants all follow it.</description>
    <workerClass>LivingLandscapes.Layers.SurfaceWaterWorker</workerClass>
    <precision>UShort</precision>
    <dependsOn>
      <li>LL_Landform</li>
      <li>LL_DrainageArea</li>
      <li>LL_Wetness</li>
    </dependsOn>
    <unit>m</unit>
    <overlay>
      <icon>UI/LivingLandscapes/Overlays/SurfaceWater</icon>
      <labelFormat>0.0</labelFormat>
      <fillOpacity>0.8</fillOpacity>
      <colors>
        <li><value>0</value><color>(0.55, 0.75, 1.00, 0)</color></li>
        <li><value>0.01</value><color>(0.45, 0.70, 1.00, 0.6)</color></li>
        <li><value>1.5</value><color>(0.10, 0.30, 0.85, 0.9)</color></li>
        <li><value>4</value><color>(0.02, 0.08, 0.45, 1)</color></li>
      </colors>
    </overlay>
    <modExtensions>
      <li Class="LivingLandscapes.Layers.SurfaceWaterExtension">
        <evaporationAtZero>400</evaporationAtZero>
        <evaporationPerDegree>60</evaporationPerDegree>
        <minEvaporation>150</minEvaporation>
        <!-- The one lake rule (#180): a hollow holds a lake where its water stands at least this deep (m) above its
             floor, whatever its size; shallower water is damp ground. -->
        <minLakeDepth>0.25</minLakeDepth>
      </li>
    </modExtensions>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_WaterFlow</defName>
    <label>water flow</label>
    <description>Flow speed 0..1 of water in stream channels; 0 in lakes and on land. Flowing water is moving water in game.</description>
    <workerClass>LivingLandscapes.Layers.WaterFlowWorker</workerClass>
    <precision>Byte</precision>
    <dependsOn>
      <li>LL_Landform</li>
      <li>LL_DrainageArea</li>
      <li>LL_SurfaceWater</li>
    </dependsOn>
    <overlay>
      <icon>UI/LivingLandscapes/Overlays/WaterFlow</icon>
      <labelFormat>0.0</labelFormat>
      <fillOpacity>0.8</fillOpacity>
      <directionLayer>LL_Aspect</directionLayer>
      <colors>
        <li><value>0</value><color>(0.3, 0.9, 0.9, 0)</color><label>still</label></li>
        <li><value>0.4</value><color>(0.3, 0.8, 0.9, 0.6)</color><label>gentle</label></li>
        <li><value>1</value><color>(0.0, 0.4, 0.8, 1)</color><label>fast</label></li>
      </colors>
    </overlay>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_WaterDistance</defName>
    <label>distance to water</label>
    <description>Distance to the nearest water or river cell. Maps without water read 999 everywhere.</description>
    <workerClass>LivingLandscapes.Layers.WaterDistanceWorker</workerClass>
    <precision>UShort</precision>
    <unit>cells</unit>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_Moisture</defName>
    <label>moisture</label>
    <description>0 (dry) to 1 (saturated): the water rain keeps in freely drained ground (rainfall over evaporation), raised where water gathers from upslope and near open water. Plants read it.</description>
    <workerClass>LivingLandscapes.Layers.MoistureWorker</workerClass>
    <dependsOn>
      <li>LL_WaterDistance</li>
      <li>LL_Wetness</li>
    </dependsOn>
    <overlay>
      <icon>UI/LivingLandscapes/Overlays/Moisture</icon>
      <labelFormat>0.0</labelFormat>
      <fillOpacity>0.75</fillOpacity>
      <colors>
        <li><value>0</value><color>(0.55, 0.75, 1.00, 0)</color><label>dry</label></li>
        <li><value>0.3</value><color>(0.45, 0.70, 1.00, 0.35)</color><label>damp</label></li>
        <li><value>0.6</value><color>(0.20, 0.45, 0.95, 0.7)</color><label>moist</label></li>
        <li><value>1</value><color>(0.05, 0.15, 0.70, 0.95)</color><label>saturated</label></li>
      </colors>
    </overlay>
    <modExtensions>
      <li Class="LivingLandscapes.Layers.MoistureExtension">
        <waterReachCells>10</waterReachCells>
        <!-- P25 site water balance: rain alone keeps up to this moisture in drained ground; half of it at aridity index 0.5. -->
        <climateMoistureMax>0.5</climateMoistureMax>
        <aridityHalf>0.5</aridityHalf>
        <!-- #132: what the terrain readers (soil fertility, wet ground, settlement siting) read of the water field.
             false = the topographic wetness (LL_Wetness) alone, as always. true = the ground term, that wetness raised by
             the moisture rain keeps in drained ground. Plants always read this layer's full moisture, either way. -->
        <terrainReadsMoisture>false</terrainReadsMoisture>
      </li>
    </modExtensions>
  </LivingLandscapes.Environment.EnvironmentLayerDef>
  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_Sun</defName>
    <label>sun exposure</label>
    <description>0 to 1: how much direct sun a site gets, level ground 0.7. Slopes facing the sun (south in the northern hemisphere) get more, slopes facing away less, from the angle between the slope and the noon sun at the map's latitude. Clear where level ground is, gold for more sun, blue for less.</description>
    <workerClass>LivingLandscapes.Layers.SunWorker</workerClass>
    <dependsOn>
      <li>LL_Slope</li>
      <li>LL_Aspect</li>
    </dependsOn>
    <overlay>
      <icon>UI/LivingLandscapes/Overlays/SunExposure</icon>
      <labelFormat>0.00</labelFormat>
      <fillOpacity>0.6</fillOpacity>
      <colors>
        <!-- Exposure works in ratios (#126): a stop at each halving below level ground (0.7), so every doubling of
             exposure is an equal step in colour; 0.84 is the ratio midpoint between level ground and full sun. -->
        <li><value>0</value><color>(0.15, 0.15, 0.45, 0.85)</color><label>shaded slope</label></li>
        <li><value>0.044</value><color>(0.32, 0.31, 0.48, 0.68)</color></li>
        <li><value>0.0875</value><color>(0.49, 0.47, 0.51, 0.51)</color></li>
        <li><value>0.175</value><color>(0.66, 0.63, 0.54, 0.34)</color></li>
        <li><value>0.35</value><color>(0.83, 0.79, 0.57, 0.17)</color></li>
        <li><value>0.7</value><color>(1.0, 0.95, 0.6, 0)</color><label>level ground</label></li>
        <li><value>0.84</value><color>(1.0, 0.85, 0.35, 0.43)</color></li>
        <li><value>1</value><color>(1.0, 0.75, 0.1, 0.85)</color><label>sunny slope</label></li>
      </colors>
    </overlay>
    <modExtensions>
      <li Class="LivingLandscapes.Layers.SunExtension">
        <flatExposure>0.7</flatExposure>
      </li>
    </modExtensions>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_Shade</defName>
    <label>canopy shade</label>
    <description>Dev view, computed when shown: 0 to 1, light blocked by the plants standing now (shifted towards the pole), as the plant ecology keeps it for the spawner. Not saved.</description>
    <workerClass>LivingLandscapes.Layers.ShadeWorker</workerClass>
    <onDemand>true</onDemand>
    <overlay>
      <icon>UI/LivingLandscapes/Overlays/CanopyShade</icon>
      <labelFormat>0.0</labelFormat>
      <fillOpacity>0.7</fillOpacity>
      <colors>
        <li><value>0</value><color>(0.1, 0.2, 0.1, 0)</color><label>open sky</label></li>
        <li><value>1</value><color>(0.05, 0.12, 0.05, 0.9)</color><label>deep shade</label></li>
      </colors>
    </overlay>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_Fitness</defName>
    <label>plant fitness</label>
    <description>Dev view: 0 to 1, how well the chosen species (debug action "Plant fitness: choose species", else the best of the biome's plants) would grow on each cell now, as the plant ecology scores it (moisture, soil depth, slope, sun, fertility, live shade). Computed when shown; not saved.</description>
    <workerClass>LivingLandscapes.Layers.FitnessWorker</workerClass>
    <onDemand>true</onDemand>
    <dependsOn>
      <li>LL_Moisture</li>
      <li>LL_SoilDepth</li>
      <li>LL_Slope</li>
      <li>LL_Sun</li>
    </dependsOn>
    <overlay>
      <icon>UI/LivingLandscapes/Overlays/PlantFitness</icon>
      <labelFormat>0.0</labelFormat>
      <fillOpacity>0.75</fillOpacity>
      <colors>
        <li><value>0</value><color>(0.6, 0.1, 0.1, 0.5)</color><label>cannot grow</label></li>
        <li><value>0.5</value><color>(0.9, 0.85, 0.3, 0.5)</color><label>struggles</label></li>
        <li><value>1</value><color>(0.1, 0.7, 0.2, 0.85)</color><label>thrives</label></li>
      </colors>
    </overlay>
  </LivingLandscapes.Environment.EnvironmentLayerDef>
  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_WalkEffort</defName>
    <label>walking effort</label>
    <description>Dev view: how many times longer than a level step the slowest step into each cell takes for the slope alone (climbing in from any neighbour, natural ground); 1 is level, 0 impassable. Vanilla's own costs (terrain, plants, cliffs) are left out. Computed when shown; not saved.</description>
    <workerClass>LivingLandscapes.Layers.WalkEffortWorker</workerClass>
    <onDemand>true</onDemand>
    <dependsOn>
      <li>LL_Landform</li>
    </dependsOn>
    <overlay>
      <icon>UI/LivingLandscapes/Overlays/WalkingEffort</icon>
      <labelFormat>0.0</labelFormat>
      <fillOpacity>0.7</fillOpacity>
      <colors>
        <li><value>0</value><color>(0.2, 0.2, 0.2, 0.8)</color></li>
        <li><value>1</value><color>(0.2, 0.7, 0.3, 0)</color></li>
        <li><value>1.5</value><color>(0.9, 0.85, 0.3, 0.6)</color></li>
        <li><value>3</value><color>(0.95, 0.5, 0.15, 0.8)</color></li>
        <li><value>8</value><color>(0.8, 0.1, 0.1, 0.9)</color></li>
      </colors>
    </overlay>
  </LivingLandscapes.Environment.EnvironmentLayerDef>
  <!-- Disturbance mosaic (P22, tools/Docs/DISTURBANCE-MOSAIC.md): years since the last stand-replacing fire or windthrow. -->
  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_StandAge</defName>
    <label>stand age</label>
    <description>Years since the last stand-replacing disturbance (fire, windthrow). Young patches are meadow and shrub thicket, older ones young then old forest.</description>
    <workerClass>LivingLandscapes.Layers.StandAgeWorker</workerClass>
    <unit>years</unit>
    <precision>UShort</precision>
    <dependsOn>
      <li>LL_Moisture</li>
      <li>LL_Sun</li>
      <li>LL_SoilDepth</li>
      <li>LL_Elevation</li>
    </dependsOn>
    <overlay>
      <icon>UI/LivingLandscapes/Overlays/StandAge</icon>
      <labelFormat>0</labelFormat>
      <fillOpacity>0.75</fillOpacity>
      <colors>
        <li><value>0</value><color>(0.95, 0.85, 0.30, 0.9)</color><label>open ground</label></li>
        <li><value>6</value><color>(0.75, 0.85, 0.30, 0.85)</color><label>shrub thicket</label></li>
        <li><value>18</value><color>(0.40, 0.70, 0.25, 0.8)</color><label>young forest</label></li>
        <li><value>45</value><color>(0.15, 0.45, 0.15, 0.75)</color><label>old forest</label></li>
        <li><value>200</value><color>(0.05, 0.25, 0.10, 0.6)</color><label>old growth</label></li>
      </colors>
    </overlay>
    <modExtensions>
      <li Class="LivingLandscapes.Layers.StandAgeExtension">
        <!-- Rotation R (years) at the biome's typical rainfall; the tile's rainfall scales it (fuel x dryness).
             Owner approved the draft rotations 2026-10-26. -->
        <regimes>
          <li><biome>TemperateForest</biome><years>250</years><rainfall>1200</rainfall><fireShare>0.5</fireShare></li>
          <li><biome>BorealForest</biome><years>120</years><rainfall>600</rainfall><fireShare>0.8</fireShare></li>
          <li><biome>TropicalRainforest</biome><years>800</years><rainfall>2500</rainfall><fireShare>0.1</fireShare></li>
          <li><biome>TemperateSwamp</biome><years>400</years><rainfall>1500</rainfall><fireShare>0.2</fireShare></li>
          <li><biome>TropicalSwamp</biome><years>800</years><rainfall>2500</rainfall><fireShare>0.1</fireShare></li>
          <li><biome>Grasslands</biome><years>5</years><rainfall>700</rainfall><fireShare>1</fireShare></li>
          <li><biome>AridShrubland</biome><years>60</years><rainfall>350</rainfall><fireShare>1</fireShare></li>
          <li><biome>Desert</biome><years>500</years><rainfall>150</rainfall><fireShare>1</fireShare></li>
          <li><biome>Tundra</biome><years>300</years><rainfall>300</rainfall><fireShare>0.6</fireShare></li>
        </regimes>
        <fallback><years>200</years><rainfall>1000</rainfall><fireShare>0.5</fireShare></fallback>
        <patchCells>20~3000</patchCells>
        <fireSizeExponent>0.4</fireSizeExponent>
        <windSizeExponent>1.0</windSizeExponent>
      </li>
    </modExtensions>
  </LivingLandscapes.Environment.EnvironmentLayerDef>
</Defs>
