<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Per-cell environment layers. Each is computed once at map generation, in dependency order, and saved with the
    map. <overlay> controls the dev-mode overlay and PNG export: a colour ramp (layer units), optional flat
    hypsometric bands, contour interval, and every n-th contour as a thicker, labelled index line.
  -->

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_Elevation</defName>
    <label>vanilla elevation</label>
    <description>Vanilla map-generation elevation, as generated (noise; lakes flattened to 0, rivers -1). Rock forms above 0.7; lakes are carved below 0.</description>
    <workerClass>LivingLandscapes.Layers.ElevationWorker</workerClass>
    <precision>UShort</precision>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <!--
    Geology: one height surface, metres above sea level, that all downstream layers read.
    Geological terrain on: generated from geological principles and used to place rock, scree and soil.
    Off: inferred from the terrain vanilla placed. A map cell is about 1 m (a twin bed is 2 x 1 cells).
  -->

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_Landform</defName>
    <label>topology</label>
    <description>The natural ground surface in metres above sea level, as erosion shaped it, before terracing. Soil and mountain rock follow it.</description>
    <workerClass>LivingLandscapes.Layers.LandformWorker</workerClass>
    <precision>UShort</precision>
    <unit>m</unit>
    <dependsOn>
      <li>LL_Elevation</li>
    </dependsOn>
    <overlay>
      <banded>true</banded>
      <relativeColors>true</relativeColors>
      <autoContourCount>20</autoContourCount>
      <indexEvery>5</indexEvery>
      <labelFormat>0.#</labelFormat>
      <colors>
        <li><value>0</value><color>(0.30, 0.58, 0.32)</color></li>
        <li><value>0.2</value><color>(0.55, 0.76, 0.40)</color></li>
        <li><value>0.4</value><color>(0.90, 0.88, 0.52)</color></li>
        <li><value>0.6</value><color>(0.93, 0.74, 0.47)</color></li>
        <li><value>0.8</value><color>(0.70, 0.48, 0.33)</color></li>
        <li><value>1</value><color>(0.92, 0.91, 0.90)</color></li>
      </colors>
    </overlay>
    <modExtensions>
      <li Class="LivingLandscapes.Geology.GeologyGenerationExtension">
        <!-- Channels from drainage (TerrainChannels). The ground absorbs rain first: runoff = (climate wetness -
             absorption) / (1 - absorption), by biome. Drainage lines are seeps until their water exceeds what the
             saturated ground carries (seepCapacityWidth at the median slope, more on gentle ground: channel heads); the
             channel carries the excess, so it starts one cell wide. Seeps are marsh, mud, or a damp or dry bed by how
             much water they gather. On a tile without
             a world river the map's water is vanilla's world flow through the tile as a share of a creek's. Channels lose
             water into their bed (transmissionLoss x the biome's absorption, per cell of length and width). -->
        <terrainChannels>
          <transmissionLoss>6</transmissionLoss>
          <absorption>0.3</absorption>
          <seepCapacityWidth>2</seepCapacityWidth>
          <biomeAbsorption>
            <li><biome>TemperateSwamp</biome><absorption>0</absorption></li>
            <li><biome>TropicalSwamp</biome><absorption>0</absorption></li>
            <li><biome>ColdBog</biome><absorption>0</absorption></li>
            <li><biome>Tundra</biome><absorption>0.1</absorption></li>
            <li><biome>IceSheet</biome><absorption>0.1</absorption></li>
            <li><biome>TropicalRainforest</biome><absorption>0.3</absorption></li>
            <li><biome>BorealForest</biome><absorption>0.3</absorption></li>
            <li><biome>TemperateForest</biome><absorption>0.4</absorption></li>
            <li><biome>AridShrubland</biome><absorption>0.5</absorption></li>
            <li><biome>Desert</biome><absorption>0.6</absorption></li>
            <li><biome>ExtremeDesert</biome><absorption>0.7</absorption></li>
          </biomeAbsorption>
        </terrainChannels>
        <cellSize>1</cellSize>
        <strata>
          <bedThickness>8~30</bedThickness>
          <dip>5~35</dip>
          <!-- How the beds lie by the tile's hilliness. Near-horizontal beds outcrop along the contours, so the bands of rock
               read like a topographic map; bedsAcrossRelief sets how many bands the relief shows. Steep tilts (straight
               stripes, hogbacks) only on rugged tiles and only sometimes (steepChance). First pass, to be tuned by eye. -->
          <byHilliness>
            <li><hilliness>Flat</hilliness><dip>0~1</dip><bedsAcrossRelief>3~4</bedsAcrossRelief></li>
            <li><hilliness>SmallHills</hilliness><dip>0~2</dip><bedsAcrossRelief>6~8</bedsAcrossRelief><intrusionShare>0.02</intrusionShare></li>
            <li><hilliness>LargeHills</hilliness><dip>0~4</dip><steepChance>0.1</steepChance><bedsAcrossRelief>10~14</bedsAcrossRelief><intrusionShare>0.06</intrusionShare></li>
            <li><hilliness>Mountainous</hilliness><dip>2~8</dip><steepChance>0.3</steepChance><steepDip>20~45</steepDip><bedsAcrossRelief>14~20</bedsAcrossRelief><intrusionShare>0.1</intrusionShare></li>
            <li><hilliness>Impassable</hilliness><dip>3~10</dip><steepChance>0.4</steepChance><steepDip>25~50</steepDip><bedsAcrossRelief>18~24</bedsAcrossRelief><intrusionShare>0.14</intrusionShare></li>
          </byHilliness>
          <warpAmplitude>12</warpAmplitude>
          <warpScale>60</warpScale>
          <jointSpacing>25~45</jointSpacing>
          <jointWidth>2</jointWidth>
          <jointWeakness>0.35</jointWeakness>
          <strengthJitter>0.15</strengthJitter>
          <softBedChance>0.4</softBedChance>
          <softBedFactor>0.45</softBedFactor>
          <openJoints>0.5</openJoints>
          <contrast>2</contrast>
        </strata>
        <reliefFlat>4</reliefFlat>
        <reliefSmallHills>20</reliefSmallHills>
        <reliefLargeHills>70</reliefLargeHills>
        <reliefMountainous>180</reliefMountainous>
        <reliefImpassable>300</reliefImpassable>
        <tileSpacingMetres>30000</tileSpacingMetres>
        <landformWavelength>300</landformWavelength>
        <detailWavelength>100</detailWavelength>
        <detailUplift>0.3</detailUplift>
        <ridgedness>0.2</ridgedness>
        <ridgednessMountains>0.6</ridgednessMountains>
        <erosionCellSize>2</erosionCellSize>
        <regionScale>2.5</regionScale>
        <erosionIterations>120</erosionIterations>
        <erodibility>0.05</erodibility>
        <areaExponent>0.5</areaExponent>
        <hillslopeDiffusion>0.12</hillslopeDiffusion>
        <regionalUpliftBias>0.5</regionalUpliftBias>
        <riverInflow>8</riverInflow>
        <!-- Channel network (rules V1-V3): channels first, valleys follow; widths compressed to map scale. -->
        <network>
          <sourceShare>0.02</sourceShare>
          <minLengthInside>20</minLengthInside>
          <!-- Vanilla width by class (creek 4, river 6, large 14, huge 30) to map width. -->
          <worldRiverWidth>
            <points>
              <li>(4, 3)</li>
              <li>(6, 6)</li>
              <li>(14, 12)</li>
              <li>(30, 24)</li>
            </points>
          </worldRiverWidth>
        </network>
        <microRelief>0.3</microRelief>
        <microWavelength>6</microWavelength>
      </li>
      <li Class="LivingLandscapes.Geology.HeightInferenceExtension">
        <smoothingSigma>2.5</smoothingSigma>
        <basinDepth>0.12</basinDepth>
        <basinReach>18</basinReach>
        <wetBasinFactor>0.5</wetBasinFactor>
        <shoreDrop>0.01</shoreDrop>
        <riverIncision>0.04</riverIncision>
        <riverGradientPerCell>0.0006</riverGradientPerCell>
        <rockThreshold>0.7</rockThreshold>
        <rockEdgeSigma>1</rockEdgeSigma>
        <maxBreachDepth>0.06</maxBreachDepth>
        <drainageEpsilon>0.00005</drainageEpsilon>
      </li>
    </modExtensions>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_Height</defName>
    <label>height</label>
    <description>Walkable ground height in metres above sea level. With geological terrain on, the landform stepped into stages of level ground with cliffs at their edges.</description>
    <workerClass>LivingLandscapes.Layers.HeightWorker</workerClass>
    <precision>UShort</precision>
    <unit>m</unit>
    <dependsOn>
      <li>LL_Landform</li>
    </dependsOn>
    <modExtensions>
      <li Class="LivingLandscapes.Geology.TerraceExtension">
        <stagesAcrossRelief>12</stagesAcrossRelief>
        <minStageHeight>2</minStageHeight>
        <treadRise>0.2</treadRise>
        <stepSpacing>24</stepSpacing>
        <knobMaxCells>150</knobMaxCells>
        <gentleSlope>0.9</gentleSlope>
        <cliffSlope>1.0</cliffSlope>
        <steepnessSmoothing>2</steepnessSmoothing>
      </li>
    </modExtensions>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_RockStrength</defName>
    <label>rock strength</label>
    <description>Strength of the rock beneath the ground, 0 to 1: tilted beds of the tile's rock types, weakened along joints. Hard beds stand as ridges and narrows; soft beds wear into valleys. Only with geological terrain on.</description>
    <workerClass>LivingLandscapes.Layers.RockStrengthWorker</workerClass>
    <precision>Byte</precision>
    <dependsOn>
      <li>LL_Landform</li>
    </dependsOn>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_SoilDepth</defName>
    <label>soil depth</label>
    <description>Depth of soil over bedrock. Thin on steep ground and crests, deep in hollows and valley floors; bedrock is exposed where none remains.</description>
    <workerClass>LivingLandscapes.Layers.SoilDepthWorker</workerClass>
    <unit>m</unit>
    <dependsOn>
      <li>LL_Landform</li>
      <li>LL_RockStrength</li>
      <li>LL_Alluvium</li>
    </dependsOn>
    <overlay>
      <labelFormat>0.0</labelFormat>
      <colors>
        <li><value>0</value><color>(0.45, 0.45, 0.48)</color></li>
        <li><value>0.3</value><color>(0.75, 0.70, 0.55)</color></li>
        <li><value>1</value><color>(0.60, 0.50, 0.30)</color></li>
        <li><value>2.4</value><color>(0.30, 0.22, 0.12)</color></li>
      </colors>
    </overlay>
    <modExtensions>
      <li Class="LivingLandscapes.Geology.SoilModelExtension">
        <baseSoilDepth>1.2</baseSoilDepth>
        <bareRockSlope>0.84</bareRockSlope>
        <hollowBonus>1.0</hollowBonus>
        <crestLoss>0.5</crestLoss>
        <soilOnWeakRock>1.5</soilOnWeakRock>
        <soilOnStrongRock>0.3</soilOnStrongRock>
        <bareSlopeOnWeakRock>1.3</bareSlopeOnWeakRock>
        <bareSlopeOnStrongRock>0.5</bareSlopeOnStrongRock>
        <rockWallDepth>0.15</rockWallDepth>
        <!-- Flat land is mostly soil: its rock comes from a plains feature (owner 2026-10-21: flat maps had too much rock). -->
        <rockShareFlat>0.01~0.04</rockShareFlat>
      </li>
    </modExtensions>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_Debris</defName>
    <label>rock debris</label>
    <description>Rock fragments shed by bare rock faces, collected where they come to rest as the slope eases: the number of faces feeding each cell. Scree lies where it is high.</description>
    <workerClass>LivingLandscapes.Layers.DebrisWorker</workerClass>
    <dependsOn>
      <li>LL_Landform</li>
      <li>LL_SoilDepth</li>
    </dependsOn>
    <overlay>
      <labelFormat>0.0</labelFormat>
      <fillOpacity>0.75</fillOpacity>
      <colors>
        <li><value>0</value><color>(0.6, 0.6, 0.6, 0)</color></li>
        <li><value>1</value><color>(0.6, 0.55, 0.5, 0.6)</color></li>
        <li><value>10</value><color>(0.3, 0.25, 0.2, 1)</color></li>
      </colors>
    </overlay>
    <modExtensions>
      <li Class="LivingLandscapes.Layers.DebrisExtension">
        <faceSlope>0.5</faceSlope>
        <restSlope>0.25</restSlope>
        <maxRun>40</maxRun>
        <spread>1.5</spread>
      </li>
    </modExtensions>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_DrainageArea</defName>
    <label>drainage area</label>
    <description>Upslope area draining through each cell (log10 of cells): 0 on ridges, high along gullies and valley floors.</description>
    <workerClass>LivingLandscapes.Layers.DrainageAreaWorker</workerClass>
    <dependsOn>
      <li>LL_Landform</li>
    </dependsOn>
    <unit>log10 cells</unit>
    <overlay>
      <labelFormat>0.0</labelFormat>
      <fillOpacity>0.65</fillOpacity>
      <colors>
        <li><value>0</value><color>(0.95, 0.93, 0.85)</color></li>
        <li><value>1.5</value><color>(0.80, 0.85, 0.70)</color></li>
        <li><value>2.5</value><color>(0.45, 0.70, 0.85)</color></li>
        <li><value>3.5</value><color>(0.15, 0.40, 0.85)</color></li>
        <li><value>4.8</value><color>(0.05, 0.10, 0.45)</color></li>
      </colors>
    </overlay>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_Slope</defName>
    <label>slope</label>
    <description>Steepness of the ground, rise over run (0.1 is about 6 degrees, 1 is 45). Drawn as arrows pointing downhill; longer and redder is steeper.</description>
    <workerClass>LivingLandscapes.Layers.SlopeWorker</workerClass>
    <dependsOn>
      <li>LL_Landform</li>
    </dependsOn>
    <overlay>
      <relativeColors>true</relativeColors>
      <contourInterval>0</contourInterval>
      <fillOpacity>0.8</fillOpacity>
      <directionLayer>LL_Aspect</directionLayer>
      <labelFormat>0.00</labelFormat>
      <colors>
        <li><value>0</value><color>(1.0, 1.0, 1.0, 0.0)</color></li>
        <li><value>0.5</value><color>(1.0, 0.5, 0.3, 0.5)</color></li>
        <li><value>1</value><color>(0.8, 0.1, 0.1, 1.0)</color></li>
      </colors>
    </overlay>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_Aspect</defName>
    <label>slope aspect</label>
    <description>Downhill direction of the ground in radians, counter-clockwise from east (0 east, 1.57 north, 3.14 west, 4.71 south).</description>
    <workerClass>LivingLandscapes.Layers.AspectWorker</workerClass>
    <dependsOn>
      <li>LL_Landform</li>
    </dependsOn>
    <overlay>
      <labelFormat>0.00</labelFormat>
      <colors>
        <li><value>0</value><color>(1.00, 0.00, 0.00)</color></li>
        <li><value>1.57</value><color>(0.00, 1.00, 0.00)</color></li>
        <li><value>3.14</value><color>(0.00, 0.00, 1.00)</color></li>
        <li><value>4.71</value><color>(1.00, 0.00, 1.00)</color></li>
        <li><value>6.28</value><color>(1.00, 0.00, 0.00)</color></li>
      </colors>
    </overlay>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_Wetness</defName>
    <label>wetness</label>
    <description>0 (dry) to 1 (wet): where water collects and the water table is near the surface, from drainage area, slope and height above the nearest drainage line; sharper on dry tiles. Drives soil fertility and wet ground.</description>
    <workerClass>LivingLandscapes.Layers.WetnessWorker</workerClass>
    <precision>Byte</precision>
    <dependsOn>
      <li>LL_Landform</li>
      <li>LL_DrainageArea</li>
    </dependsOn>
    <modExtensions>
      <li Class="LivingLandscapes.Layers.WetnessExtension">
        <slopeSmoothing>2</slopeSmoothing>
        <channelArea>2.5</channelArea>
        <heightAboveDrainageScale>2</heightAboveDrainageScale>
        <wetnessIndexRange>4~13</wetnessIndexRange>
        <wetnessIndexWeight>0.5</wetnessIndexWeight>
        <wetRainfallMm>1500</wetRainfallMm>
        <aridSharpening>3</aridSharpening>
        <unknownRainfall>0.4</unknownRainfall>
      </li>
      <li Class="LivingLandscapes.Geology.GroundWriterExtension">
        <fertilityWetness>0.55</fertilityWetness>
        <fertilitySoilDepth>0.35</fertilitySoilDepth>
        <fertilityNoise>0.1</fertilityNoise>
        <deepSoil>2</deepSoil>
      </li>
    </modExtensions>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_SurfaceWater</defName>
    <label>surface water</label>
    <description>Depth of standing and flowing water in metres, from the landform: lakes fill closed hollows to the level where rain on their catchment balances evaporation; streams run where enough ground drains, wider the more it drains. Terrain, cliffs and plants all follow it.</description>
    <workerClass>LivingLandscapes.Layers.SurfaceWaterWorker</workerClass>
    <precision>UShort</precision>
    <dependsOn>
      <li>LL_Landform</li>
      <li>LL_DrainageArea</li>
      <li>LL_Wetness</li>
    </dependsOn>
    <unit>m</unit>
    <overlay>
      <labelFormat>0.0</labelFormat>
      <fillOpacity>0.8</fillOpacity>
      <colors>
        <li><value>0</value><color>(0.55, 0.75, 1.00, 0)</color></li>
        <li><value>0.01</value><color>(0.45, 0.70, 1.00, 0.6)</color></li>
        <li><value>1.5</value><color>(0.10, 0.30, 0.85, 0.9)</color></li>
        <li><value>4</value><color>(0.02, 0.08, 0.45, 1)</color></li>
      </colors>
    </overlay>
    <modExtensions>
      <li Class="LivingLandscapes.Layers.SurfaceWaterExtension">
        <evaporationAtZero>400</evaporationAtZero>
        <evaporationPerDegree>60</evaporationPerDegree>
        <minEvaporation>150</minEvaporation>
        <minLakeDepth>0.25</minLakeDepth>
        <minLakeCells>12</minLakeCells>
      </li>
    </modExtensions>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_WaterFlow</defName>
    <label>water flow</label>
    <description>Flow speed 0..1 of water in stream channels; 0 in lakes and on land. Flowing water is moving water in game.</description>
    <workerClass>LivingLandscapes.Layers.WaterFlowWorker</workerClass>
    <precision>Byte</precision>
    <dependsOn>
      <li>LL_Landform</li>
      <li>LL_DrainageArea</li>
      <li>LL_SurfaceWater</li>
    </dependsOn>
    <overlay>
      <labelFormat>0.0</labelFormat>
      <fillOpacity>0.8</fillOpacity>
      <directionLayer>LL_Aspect</directionLayer>
      <colors>
        <li><value>0</value><color>(0.3, 0.9, 0.9, 0)</color></li>
        <li><value>0.4</value><color>(0.3, 0.8, 0.9, 0.6)</color></li>
        <li><value>1</value><color>(0.0, 0.4, 0.8, 1)</color></li>
      </colors>
    </overlay>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_WaterDistance</defName>
    <label>distance to water</label>
    <description>Distance to the nearest water or river cell. Maps without water read 999 everywhere.</description>
    <workerClass>LivingLandscapes.Layers.WaterDistanceWorker</workerClass>
    <precision>UShort</precision>
    <unit>cells</unit>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_Moisture</defName>
    <label>moisture</label>
    <description>0 (dry) to 1 (saturated): ground wetness from drainage and climate, raised near water.</description>
    <workerClass>LivingLandscapes.Layers.MoistureWorker</workerClass>
    <dependsOn>
      <li>LL_WaterDistance</li>
      <li>LL_Wetness</li>
    </dependsOn>
    <overlay>
      <labelFormat>0.0</labelFormat>
      <fillOpacity>0.75</fillOpacity>
      <colors>
        <li><value>0</value><color>(0.55, 0.75, 1.00, 0)</color></li>
        <li><value>0.3</value><color>(0.45, 0.70, 1.00, 0.35)</color></li>
        <li><value>0.6</value><color>(0.20, 0.45, 0.95, 0.7)</color></li>
        <li><value>1</value><color>(0.05, 0.15, 0.70, 0.95)</color></li>
      </colors>
    </overlay>
    <modExtensions>
      <li Class="LivingLandscapes.Layers.MoistureExtension">
        <waterReachCells>10</waterReachCells>
      </li>
    </modExtensions>
  </LivingLandscapes.Environment.EnvironmentLayerDef>
  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_Sun</defName>
    <label>sun exposure</label>
    <description>0 to 1: how much sun a site gets. Level ground is mid-high; slopes facing the sun (south in the northern hemisphere) more, slopes facing away less. Aspect matters less near the equator.</description>
    <workerClass>LivingLandscapes.Layers.SunWorker</workerClass>
    <dependsOn>
      <li>LL_Slope</li>
      <li>LL_Aspect</li>
    </dependsOn>
    <overlay>
      <labelFormat>0.0</labelFormat>
      <fillOpacity>0.6</fillOpacity>
      <colors>
        <li><value>0</value><color>(0.15, 0.15, 0.45, 0.8)</color></li>
        <li><value>0.5</value><color>(1.0, 0.95, 0.6, 0.1)</color></li>
        <li><value>1</value><color>(1.0, 0.75, 0.1, 0.85)</color></li>
      </colors>
    </overlay>
    <modExtensions>
      <li Class="LivingLandscapes.Layers.SunExtension">
        <flatExposure>0.7</flatExposure>
        <slopeGain>1.5</slopeGain>
        <fullAspectLatitude>40</fullAspectLatitude>
      </li>
    </modExtensions>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_Shade</defName>
    <label>canopy shade</label>
    <description>Dev view, computed when shown: 0 to 1, light blocked by the plants standing now (shifted towards the pole), as the plant ecology keeps it for the spawner. Not saved.</description>
    <workerClass>LivingLandscapes.Layers.ShadeWorker</workerClass>
    <onDemand>true</onDemand>
    <overlay>
      <labelFormat>0.0</labelFormat>
      <fillOpacity>0.7</fillOpacity>
      <colors>
        <li><value>0</value><color>(0.1, 0.2, 0.1, 0)</color></li>
        <li><value>1</value><color>(0.05, 0.12, 0.05, 0.9)</color></li>
      </colors>
    </overlay>
  </LivingLandscapes.Environment.EnvironmentLayerDef>

  <LivingLandscapes.Environment.EnvironmentLayerDef>
    <defName>LL_Fitness</defName>
    <label>plant fitness</label>
    <description>Dev view: 0 to 1, how well the chosen species (debug action "Plant fitness: choose species", else the best of the biome's plants) would grow on each cell now, as the plant ecology scores it (moisture, soil depth, slope, sun, fertility, live shade). Computed when shown; not saved.</description>
    <workerClass>LivingLandscapes.Layers.FitnessWorker</workerClass>
    <onDemand>true</onDemand>
    <dependsOn>
      <li>LL_Moisture</li>
      <li>LL_SoilDepth</li>
      <li>LL_Slope</li>
      <li>LL_Sun</li>
    </dependsOn>
    <overlay>
      <labelFormat>0.0</labelFormat>
      <fillOpacity>0.75</fillOpacity>
      <colors>
