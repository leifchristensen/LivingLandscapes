<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Water regimes (map scale, Docs/WATER-REGIMES.md). Tried in order; the first whose mutators (any one of them) and
    conditions match the tile is the map's. Regimes tied to a mutator come first, so those maps are distinct. Tile
    fields: Rainfall (mm), Temperature (C), Hilliness (1 flat, 2 small hills, 3 large hills, 4 mountainous,
    5 impassable), Elevation (m), River (vanilla width of the world river, 0 if none), Coast (1 by the sea).
    sourceShare: channels start where drainage reaches this share of the map's area (lower: denser network).
    floodplainScale: how far the water table stays up beside channels (marsh between a wetland's threads, thin damp
    strips on arid maps).
    climateOffset: added to the tile's climate wetness (0..1 from rainfall) for every water and wet ground rule.
    marshland: 0..1, how much damp ground becomes marsh (ground rules field Marshland).
    channelRegimes: weights on channel regimes (0 forbids; unlisted weigh 1; exclusive regimes only where listed).
    nudges: map-wide factors on the channel processes (Docs/WATER-AUDIT.md, step 4): discharge (where channels start;
    below 1 a denser network), width, depth, widthNoise, depthNoise, bankNoise, spread (water divides more readily).
    Keep within about 0.5..3.
    Terrain nudges (step 5): centreDepression or centreKnob (metres, at the river centre, centreRadiusShare of the map
    across; a knob is resistant rock, knobRockStrength), exitFlatten (0..1, relief eased toward base level within
    exitReachShare of the map of the river's exit).
    replacesMutatorTerrain: the regime models its mutators' water; their own painting stands aside.
    World river structure: riverInflow (false: the river rises on the map), allRiverLinks (every river link enters:
    a confluence), sourceLakeWidths (lake the river rises from), deltaAtExit with deltaBranches and
    deltaSpreadWidths (distributaries toward the exit), centralIsland (share of map size) with centralIslandWidths.
  -->

  <LivingLandscapes.Geology.WaterRegimeDef>
    <defName>LL_Delta</defName>
    <label>delta</label>
    <exitFlatten>0.8</exitFlatten>
    <nudges>
      <depth>0.8</depth>
      <depthNoise>1.4</depthNoise>
      <spread>2.5</spread>
      <deposition>2.5</deposition>
    </nudges>
    <order>10</order>
    <mutators><li>RiverDelta</li></mutators>
    <replacesMutatorTerrain>true</replacesMutatorTerrain>
    <sourceShare>0.03~0.04</sourceShare>
    <floodplainScale>1.5</floodplainScale>
    <deltaAtExit>true</deltaAtExit>
    <deltaBranches>3~5</deltaBranches>
    <deltaSpreadWidths>3~4</deltaSpreadWidths>
    <channelRegimes>
      <li><regime>LL_Braided</regime><weight>3</weight></li>
      <li><regime>LL_Anabranching</regime><weight>3</weight></li>
      <li><regime>LL_Meandering</regime><weight>2</weight></li>
    </channelRegimes>
  </LivingLandscapes.Geology.WaterRegimeDef>

  <LivingLandscapes.Geology.WaterRegimeDef>
    <defName>LL_Confluence</defName>
    <label>confluence</label>
    <order>11</order>
    <mutators><li>RiverConfluence</li></mutators>
    <replacesMutatorTerrain>true</replacesMutatorTerrain>
    <sourceShare>0.025~0.035</sourceShare>
    <allRiverLinks>true</allRiverLinks>
    <channelRegimes>
      <li><regime>LL_Anabranching</regime><weight>2</weight></li>
    </channelRegimes>
  </LivingLandscapes.Geology.WaterRegimeDef>

  <LivingLandscapes.Geology.WaterRegimeDef>
    <defName>LL_RiverIsland</defName>
    <label>river island</label>
    <centreDepression>1~1.5</centreDepression>
    <centreRadiusShare>0.15</centreRadiusShare>
    <nudges>
      <widthNoise>1.3</widthNoise>
      <spread>3</spread>
      <deposition>3</deposition>
    </nudges>
    <order>12</order>
    <mutators><li>RiverIsland</li></mutators>
    <replacesMutatorTerrain>true</replacesMutatorTerrain>
    <sourceShare>0.03~0.04</sourceShare>
    <centralIsland>0.5~0.7</centralIsland>
    <centralIslandWidths>1.5~2</centralIslandWidths>
    <channelRegimes>
      <li><regime>LL_Anabranching</regime><weight>4</weight></li>
    </channelRegimes>
  </LivingLandscapes.Geology.WaterRegimeDef>

  <LivingLandscapes.Geology.WaterRegimeDef>
    <defName>LL_Headwater</defName>
    <label>headwater</label>
    <riverInflow>false</riverInflow>
    <centreDepression>2~4</centreDepression>
    <nudges>
      <discharge>0.7</discharge>
      <depth>0.9</depth>
    </nudges>
    <order>13</order>
    <mutators><li>Headwater</li></mutators>
    <replacesMutatorTerrain>true</replacesMutatorTerrain>
    <sourceShare>0.006~0.01</sourceShare>
    <sourceLakeWidths>3~4</sourceLakeWidths>
    <channelRegimes>
      <li><regime>LL_Torrent</regime><weight>3</weight></li>
      <li><regime>LL_Gorge</regime><weight>2</weight></li>
      <li><regime>LL_Meandering</regime><weight>0</weight></li>
    </channelRegimes>
  </LivingLandscapes.Geology.WaterRegimeDef>

  <LivingLandscapes.Geology.WaterRegimeDef>
    <defName>LL_MarshWeb</defName>
    <label>marsh web</label>
    <nudges>
      <discharge>0.5</discharge>
      <width>0.8</width>
      <depth>0.6</depth>
      <bankNoise>1.6</bankNoise>
      <spread>2.5</spread>
    </nudges>
    <order>14</order>
    <mutators><li>Wetland</li><li>Marshy</li></mutators>
    <replacesMutatorTerrain>true</replacesMutatorTerrain>
    <sourceShare>0.006~0.01</sourceShare>
    <floodplainScale>3</floodplainScale>
    <climateOffset>0.5</climateOffset>
    <marshland>1</marshland>
    <channelRegimes>
      <li><regime>LL_MarshThread</regime><weight>4</weight></li>
      <li><regime>LL_Anabranching</regime><weight>3</weight></li>
      <li><regime>LL_Meandering</regime><weight>2</weight></li>
    </channelRegimes>
  </LivingLandscapes.Geology.WaterRegimeDef>

  <LivingLandscapes.Geology.WaterRegimeDef>
    <defName>LL_Lakeland</defName>
    <label>lakeland</label>
    <nudges>
      <depth>1.1</depth>
    </nudges>
    <order>15</order>
    <mutators><li>Lake</li><li>LakeWithIsland</li><li>LakeWithIslands</li><li>Pond</li><li>Lakeshore</li><li>Oasis</li><li>CaveLakes</li></mutators>
    <sourceShare>0.02~0.03</sourceShare>
  </LivingLandscapes.Geology.WaterRegimeDef>

  <LivingLandscapes.Geology.WaterRegimeDef>
    <defName>LL_Coastal</defName>
    <label>coastal</label>
    <order>16</order>
    <mutators><li>Coast</li><li>Bay</li><li>Cove</li><li>Fjord</li><li>Peninsula</li><li>Archipelago</li></mutators>
    <sourceShare>0.02~0.03</sourceShare>
  </LivingLandscapes.Geology.WaterRegimeDef>

  <LivingLandscapes.Geology.WaterRegimeDef>
    <defName>LL_Basin</defName>
    <label>basin</label>
    <nudges>
      <width>1.1</width>
    </nudges>
    <order>17</order>
    <mutators><li>Basin</li></mutators>
    <sourceShare>0.015~0.025</sourceShare>
  </LivingLandscapes.Geology.WaterRegimeDef>

  <LivingLandscapes.Geology.WaterRegimeDef>
    <defName>LL_AridWashes</defName>
    <label>arid washes</label>
    <nudges>
      <discharge>2</discharge>
      <width>1.4</width>
      <depth>0.5</depth>
      <depthNoise>1.5</depthNoise>
      <spread>1.8</spread>
    </nudges>
    <order>20</order>
    <conditions>
      <li><field>Rainfall</field><max>400</max></li>
      <!-- Washes are the map's own dry channels. A world river keeps its vanilla width in any climate. -->
      <li><field>River</field><max>0.5</max></li>
    </conditions>
    <sourceShare>0.04~0.06</sourceShare>
    <floodplainScale>0.5</floodplainScale>
    <channelRegimes>
      <li><regime>LL_Braided</regime><weight>3</weight></li>
      <li><regime>LL_Meandering</regime><weight>0.5</weight></li>
    </channelRegimes>
  </LivingLandscapes.Geology.WaterRegimeDef>

  <LivingLandscapes.Geology.WaterRegimeDef>
    <defName>LL_DryGround</defName>
    <label>dry ground</label>
    <nudges>
      <discharge>2</discharge>
      <depth>0.6</depth>
    </nudges>
    <order>21</order>
    <mutators><li>DryGround</li></mutators>
    <sourceShare>0.04~0.06</sourceShare>
    <floodplainScale>0.5</floodplainScale>
    <channelRegimes>
      <li><regime>LL_Braided</regime><weight>3</weight></li>
    </channelRegimes>
  </LivingLandscapes.Geology.WaterRegimeDef>

  <LivingLandscapes.Geology.WaterRegimeDef>
    <defName>LL_MountainTorrents</defName>
    <label>mountain torrents</label>
    <nudges>
      <discharge>0.8</discharge>
      <width>0.85</width>
      <depth>1.1</depth>
    </nudges>
    <order>30</order>
    <conditions>
      <li><field>Hilliness</field><min>4</min></li>
    </conditions>
    <sourceShare>0.012~0.02</sourceShare>
    <channelRegimes>
      <li><regime>LL_Gorge</regime><weight>3</weight></li>
      <li><regime>LL_Torrent</regime><weight>3</weight></li>
      <li><regime>LL_Meandering</regime><weight>0.5</weight></li>
    </channelRegimes>
  </LivingLandscapes.Geology.WaterRegimeDef>

  <LivingLandscapes.Geology.WaterRegimeDef>
    <defName>LL_HillCreeks</defName>
    <label>hill creeks</label>
    <nudges>
      <discharge>0.9</discharge>
    </nudges>
    <order>31</order>
    <conditions>
      <li><field>Hilliness</field><min>2</min></li>
    </conditions>
    <sourceShare>0.012~0.02</sourceShare>
    <channelRegimes>
      <li><regime>LL_Torrent</regime><weight>2</weight></li>
      <li><regime>LL_Meandering</regime><weight>0.7</weight></li>
    </channelRegimes>
  </LivingLandscapes.Geology.WaterRegimeDef>

  <!-- The default: flat ground. -->
  <LivingLandscapes.Geology.WaterRegimeDef>
    <defName>LL_Plains</defName>
    <label>plains</label>
    <order>100</order>
    <sourceShare>0.025~0.04</sourceShare>
    <channelRegimes>
      <li><regime>LL_Meandering</regime><weight>2</weight></li>
    </channelRegimes>
  </LivingLandscapes.Geology.WaterRegimeDef>

</Defs>
