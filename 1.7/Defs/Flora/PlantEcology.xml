<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Plant ecology tuning (Docs/FLORA-REVIEW.md). Layered on vanilla's wild plant spawner: it reweights and filters what
    the spawner would place, so vanilla's biome plant lists, commonality, density and regrowth pace stay the baseline.
    The player's habitat strength setting blends every effect (0 = vanilla).
  -->
  <LivingLandscapes.Flora.PlantEcologyDef>
    <defName>LL_PlantEcology</defName>
    <label>plant ecology</label>
    <!-- Forest layers: biome x layer multipliers on vanilla's commonality (vanilla's forests are sparse). Shares renormalise. -->
    <stratumScales>
      <li><biome>TemperateForest</biome><stratum>Canopy</stratum><scale>2.5</scale></li>
      <li><biome>TemperateForest</biome><stratum>Shrub</stratum><scale>3.5</scale></li>
      <li><biome>TemperateForest</biome><stratum>Ground</stratum><scale>0.7</scale></li>
      <li><biome>BorealForest</biome><stratum>Canopy</stratum><scale>2.2</scale></li>
      <li><biome>BorealForest</biome><stratum>Shrub</stratum><scale>1.3</scale></li>
      <li><biome>BorealForest</biome><stratum>Ground</stratum><scale>0.7</scale></li>
      <li><biome>TropicalRainforest</biome><stratum>Canopy</stratum><scale>2.7</scale></li>
      <li><biome>TropicalRainforest</biome><stratum>Shrub</stratum><scale>3.3</scale></li>
      <li><biome>TemperateSwamp</biome><stratum>Canopy</stratum><scale>1.5</scale></li>
      <li><biome>TropicalSwamp</biome><stratum>Canopy</stratum><scale>1.5</scale></li>
    </stratumScales>
    <!-- Species with fitness under this (times strength) are not candidates on a cell. -->
    <minFitness>0.08</minFitness>
    <!-- Choice weight ~ fitness^this. -->
    <fitnessExponent>1.5</fitnessExponent>
    <!-- Clusters: sigma = vanilla cluster radius x this; a neighbour's weight is gain x exp(-d^2 / 2 sigma^2). -->
    <sigmaPerVanillaRadius>0.5</sigmaPerVanillaRadius>
    <clusterGainPerNeighbour>7.4</clusterGainPerNeighbour>
    <clusterReach>3</clusterReach>
    <!-- The initial planting seeds clumps first: this share of each clustering species' target as parents with Gaussian
         offspring (seedFill = share of the cells within two sigma of a parent a clump fills), then vanilla's pass fills the rest. -->
    <seedShare>0.6</seedShare>
    <seedFill>0.15</seedFill>
    <!-- A seed settles with chance (fitness / this) ^ fitnessExponent. -->
    <seedFitnessReference>0.5</seedFitnessReference>
    <!-- Seeding a new clump away from the species' own kind, relative to vanilla (below 1: fewer, larger clumps). -->
    <clusterNucleation>0.2</clusterNucleation>
    <clusterNucleation2>0.5</clusterNucleation2>
    <clusterGain2PerNeighbour>0.5</clusterGain2PerNeighbour>
    <!-- Canopy shadows fall toward the pole by this share of their radius. -->
    <shadowShift>0.5</shadowShift>
    <!-- Carrying capacity (P15), replacing vanilla's even cap: the share of cells with a plant within occupancyRadius
         targets biome plant density x fertility x densityScale x Lerp(capacityFloor, 1, (capacity / the map's 80th
         percentile) ^ densityContrast). -->
    <densityContrast>2</densityContrast>
    <capacityFloor>0.2</capacityFloor>
    <occupancyRadius>4</occupancyRadius>
    <densityScales>
      <li><biome>TemperateForest</biome><scale>2.0</scale></li>
      <li><biome>TropicalRainforest</biome><scale>2.0</scale></li>
    </densityScales>
    <!-- Growth rate multiplier from 0 (zero fitness) to 1 (full fitness). -->
    <vitalityMin>0.5</vitalityMin>
    <vitalityMax>1.2</vitalityMax>
    <!-- Habitat inputs (Docs/HABITAT-XML.md): sun-facing slopes dry faster (water = moisture - sunDrying x (sun - 0.7));
         soil shallower than a species' rooting depth limits it by (soil / rootingDepth) ^ rootRoomExponent. -->
    <sunDrying>0.15</sunDrying>
    <!-- Dispersal kernels by seed vector (P13, Docs/PLANT-TRAITS.md 4.2), relative to a species' base clump: sigmaScale =
         how far offspring land, nucleationScale = how often a new clump starts away from the species' own kind,
         clumpScale = how strongly a clump draws newcomers (after the clusterMaxRatio cap). Water carries seeds downstream
         (a stretched kernel centred one sigma downhill). The species' seed axis adds 0.8-1.2 x sigma and 0.6-1.4 x
         nucleation (many small seeds travel further). -->
    <dispersalKernels>
      <li><vector>Gravity</vector><sigmaScale>0.7</sigmaScale><nucleationScale>0.6</nucleationScale><clumpScale>1.2</clumpScale></li>
      <li><vector>Animal</vector><sigmaScale>1.0</sigmaScale><nucleationScale>1.0</nucleationScale><clumpScale>1.0</clumpScale></li>
      <li><vector>Wind</vector><sigmaScale>1.5</sigmaScale><nucleationScale>2.0</nucleationScale><clumpScale>0.6</clumpScale></li>
      <li><vector>Water</vector><sigmaScale>1.0</sigmaScale><nucleationScale>1.0</nucleationScale><clumpScale>1.0</clumpScale><downstream>true</downstream></li>
      <li><vector>Clonal</vector><sigmaScale>0.6</sigmaScale><nucleationScale>0.3</nucleationScale><clumpScale>2.0</clumpScale></li>
    </dispersalKernels>
    <rootRoomExponent>0.3</rootRoomExponent>
    <!-- Establishment: exponent on the cluster pull in a cell's acceptance chance (1 = the likely recruit decides, 0 =
         commonality alone). Measured 2026-10-25: 1 added nothing to the forest-edge shrub lead and cost swamps 6% of
         their plants, so 0 until shade mortality exists (Docs/HABITAT-XML.md, diagnostic). -->
    <establishmentPull>0</establishmentPull>
    <!-- Thicket drag (P18): cost = this x stem density of the 3x3 (sum of the plants' thicket weights / 9), at least
         vanilla's. A thick bush is about 20x slower than open soil (owner): 20 x 13 ticks per move = 260, so 250 at weight
         1. Owner playtest 2026-10-26: bushes 0.85 (closed 212), brambles 1.4 (closed 350); a lone bush keeps vanilla's 30. -->
    <thicketDragMax>250</thicketDragMax>
  </LivingLandscapes.Flora.PlantEcologyDef>

</Defs>
